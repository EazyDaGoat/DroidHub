local BASE64_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local BASE64_MAP
local function decodeBase64(data)
	if not BASE64_MAP then
		BASE64_MAP = table.create(256)
		for index = 1, #BASE64_ALPHABET do
			BASE64_MAP[string.byte(BASE64_ALPHABET, index)] = index - 1
		end
	end
	local output = table.create(
			math.floor(
				#data * 0.75
			)
		)
	local outputIndex = 0
	for index = 1, #data, 4 do
		local c = string.byte(
				data,
				index + 2
			)
		local d = string.byte(
				data,
				index + 3
			)
		local value = (BASE64_MAP[string.byte(data, index)] or 0) * 262144
			+ (BASE64_MAP[string.byte(data, index + 1)] or 0) * 4096
			+ (BASE64_MAP[c] or 0) * 64
			+ (BASE64_MAP[d] or 0)
		outputIndex += 1
		output[outputIndex] = string.char(
				math.floor(
					value / 65536
				) % 256
			)
		if c ~= 61 then
			outputIndex += 1
			output[outputIndex] = string.char(
					math.floor(
						value / 256
					) % 256
				)
		end
		if d ~= 61 then
			outputIndex += 1
			output[outputIndex] = string.char(
					value % 256
				)
		end
	end
	return table.concat(
		output,
		"",
		1,
		outputIndex
	)
end
local customAssetFunction = getcustomasset
	or getsynasset
local embeddedIconAssets = {}
local function getEmbeddedIconAsset(
	name
)
	if embeddedIconAssets[name] then
		return embeddedIconAssets[name]
	end
	local encoded = EMBEDDED_ICONS[name]
	if not encoded
		or type(writefile) ~= "function"
		or type(customAssetFunction) ~= "function" then
		return nil
	end
	local fileName = "DroidHub_" .. string.lower(name) .. "_icon.png"
	-- Embedded icons are immutable. Reuse the cached file instead of decoding/writing base64 every run.
	local cached = false
	if type(isfile) == "function" then
		local okFile, exists = pcall(isfile, fileName)
		cached = okFile and exists == true
	end
	if not cached and not pcall(writefile, fileName, decodeBase64(encoded)) then return nil end
	local ok,
		asset = pcall(
			customAssetFunction,
			fileName
		)
	if ok and asset then
		embeddedIconAssets[name] = asset
		return asset
	end
	return nil
end
