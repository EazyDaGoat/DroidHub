    local function newOpponentProfile()
        local p = {
            rounds = 0,
            attackCount = 0,
            defendCount = 0,
            powerCounts = table.create(10, 0),
            offsetSum = 0,
            offsetSq = 0,
            offsetN = 0,
            targetEdgeCount = 0,
