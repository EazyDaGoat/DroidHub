						+ menuStartY
				)
		)
	local menuAvailableHeight = math.max(
			MENU_ITEM_HEIGHT,
			panelHeight
				- SIDEBAR_PADDING
				- menuTop
		)
	menuHolder.Position = U2O(
			sidebarVisualCenterX,
