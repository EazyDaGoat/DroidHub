                    "ETERNAL=" .. tostring(offeredCountAO) .. "xBestLower+" .. tostring(aggregateTokens)
                }
            end
            if forceAllTokensAO then
                aggregateTokens = tokenBalanceAO()
                tokenRuleAuthoritative = true
                openingTakeoverAO = true
            end
            if openingTakeoverAO then
