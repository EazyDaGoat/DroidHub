					end
					rowData.Divider.Position = U2(0.5, 0, 0, dividerCenter)
				end
			end
		end

		local expandedHeight = currentHeaderHeight + UI.LINE_THICKNESS
			+ featureTopPadding + featureBottomPadding
			+ math.max(0, y - featureTopPadding - featureRowGap)
		if panelData then
			panelData.HasVisibleRows = #visibleRows > 0
			panelData.ExpandedHeight = expandedHeight
		end
		if panelData then
			panel.Size = U2O(
				panel.Size.X.Offset,
				panelData.Expanded and expandedHeight or currentHeaderHeight
			)
		else
			panel.Size = U2O(panel.Size.X.Offset, expandedHeight)
		end
		if not skipPanelRefresh and refreshUnsupportedPanels then
			task.defer(refreshUnsupportedPanels)
		end
	end

