            end
            expectedMax[draws] = expectation
        end
        local stats = {
            mean = mean,
            marginal = {
                math.max(0, expectedMax[2] - expectedMax[1]),
                math.max(0, expectedMax[3] - expectedMax[2]),
                math.max(0, expectedMax[4] - expectedMax[3]),
