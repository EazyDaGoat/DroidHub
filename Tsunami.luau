				then
					autoServerHopState.Utility.AutoAcceptTradesRequestMustHaveOne = true
				end
				local requestConfigured = false
				for _, rarity in ipairs(BRAINROT_RARITY_OPTIONS) do
					local cfg = tradeRequestCriteriaState[rarity]
					if cfg and cfg.Enabled == true then requestConfigured = true break end
				end
				if not requestConfigured and tradeRequestCriteriaState.Tokens
					and tradeRequestCriteriaState.Tokens.Enabled == true
				then
					requestConfigured = true
				end
				if not requestConfigured then
					for _, rule in ipairs(type(autoServerHopState.Utility.AutoAcceptTradesRequestSpecificItems) == "table"
						and autoServerHopState.Utility.AutoAcceptTradesRequestSpecificItems or {}) do
						if type(rule) == "table" and rule.Item ~= nil and tostring(rule.Item) ~= "" then
							requestConfigured = true
							break
						end
					end
				end
				if not requestConfigured and saved.TradeRequestCriteria == nil
					and autoServerHopState.Utility.AutoAcceptTradesAcceptRequests == true
				then
					local copied = false
					for _, rarity in ipairs(BRAINROT_RARITY_OPTIONS) do
						local source = autoAcceptState[rarity]
						if source and source.Enabled == true then
							tradeRequestCriteriaState[rarity].Enabled = true
							tradeRequestCriteriaState[rarity].Amount = math.clamp(math.floor(tonumber(source.Amount) or 1), 1, 6)
							autoServerHopState.Utility["AutoAcceptTradesRequest" .. rarity .. "Mutations"] = copyJsonSafe(autoServerHopState.Utility["AutoAccept" .. rarity .. "Mutations"]) or {}
							autoServerHopState.Utility["AutoAcceptTradesRequest" .. rarity .. "Traits"] = copyJsonSafe(autoServerHopState.Utility["AutoAccept" .. rarity .. "Traits"]) or {}
							copied = true
						end
					end
					if autoAcceptState.Tokens and autoAcceptState.Tokens.Enabled == true then
						tradeRequestCriteriaState.Tokens.Enabled = true
						tradeRequestCriteriaState.Tokens.Amount = math.clamp(math.floor(tonumber(autoAcceptState.Tokens.Amount) or 1), 1, 1000000)
						copied = true
					end
					local copiedSpecific = {}
					for _, rule in ipairs(type(autoServerHopState.Utility.AutoAcceptSpecificItems) == "table" and autoServerHopState.Utility.AutoAcceptSpecificItems or {}) do
						if type(rule) == "table" and rule.Item ~= nil and tostring(rule.Item) ~= "" then
							copiedSpecific[#copiedSpecific + 1] = {
								Item = rule.Item,
								Mutations = copyJsonSafe(rule.Mutations) or {},
								Traits = copyJsonSafe(rule.Traits) or {},
							}
						end
					end
					if #copiedSpecific > 0 then
						copiedSpecific[#copiedSpecific + 1] = {Item=nil, Mutations={}, Traits={}}
						autoServerHopState.Utility.AutoAcceptTradesRequestSpecificItems = copiedSpecific
						copied = true
					end
					if copied then
						autoServerHopState.Utility.AutoAcceptTradesRequestMustHaveAll = autoServerHopState.Utility.AutoAcceptMustHaveAll == true
						autoServerHopState.Utility.AutoAcceptTradesRequestMustHaveOne = autoServerHopState.Utility.AutoAcceptMustHaveOne == true
						requestConfigured = true
					end
				end
				if not requestConfigured then
					local migrated = false
					local selectedRarities = autoServerHopState.Utility.AutoAcceptTradesCriteriaRarities
					if type(selectedRarities) == "table" and selectedRarities.Any ~= true then
						for _, rarity in ipairs(BRAINROT_RARITY_OPTIONS) do
							if selectedRarities[rarity] == true then
								tradeRequestCriteriaState[rarity].Enabled = true
								tradeRequestCriteriaState[rarity].Amount = 1
								migrated = true
							end
						end
					end
					local oldTokens = math.max(0, math.floor(tonumber(autoServerHopState.Utility.AutoAcceptTradesCriteriaTokens) or 0))
					if oldTokens > 0 then
						tradeRequestCriteriaState.Tokens.Enabled = true
						tradeRequestCriteriaState.Tokens.Amount = math.clamp(oldTokens, 1, 1000000)
						migrated = true
					end
					local selectedItems = autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificItems
					if type(selectedItems) == "table" and selectedItems.Any ~= true then
						local converted = {}
						for itemName, enabled in pairs(selectedItems) do
							if enabled == true and tostring(itemName) ~= "Any" then
								converted[#converted + 1] = {
									Item = tostring(itemName),
									Mutations = copyJsonSafe(autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificMutations) or {},
									Traits = copyJsonSafe(autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificTraits) or {},
								}
							end
						end
						if #converted > 0 then
							converted[#converted + 1] = {Item=nil, Mutations={}, Traits={}}
							autoServerHopState.Utility.AutoAcceptTradesRequestSpecificItems = converted
							migrated = true
						end
					end
					if migrated then
						autoServerHopState.Utility.AutoAcceptTradesAcceptRequests = true
						autoServerHopState.Utility.AutoAcceptTradesRequestMustHaveAll = true
						autoServerHopState.Utility.AutoAcceptTradesRequestMustHaveOne = false
					end
				end
				autoServerHopState.Utility.AutoAcceptTradesCriteriaRarities = {Any = true}
				autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificItems = {Any = true}
				autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificMutations = {}
				autoServerHopState.Utility.AutoAcceptTradesCriteriaSpecificTraits = {}
				autoServerHopState.Utility.AutoAcceptTradesCriteriaTokens = 0
			end
			if autoServerHopState.Utility.AutoEquipBestBrainrot ~= true then
				autoServerHopState.Utility.AutoEquipModeHold = false
				autoServerHopState.Utility.AutoEquipModeMount = false
				autoServerHopState.Utility.AutoEquipModeHoldMount = false
			end
			-- Exactly one equip mode may be active. If malformed persisted data has
			-- multiple modes, prefer Hold + Mount, then Mount, then Hold.
			if autoServerHopState.Utility.AutoEquipModeHoldMount == true then
				autoServerHopState.Utility.AutoEquipModeHold = false
				autoServerHopState.Utility.AutoEquipModeMount = false
			elseif autoServerHopState.Utility.AutoEquipModeMount == true then
				autoServerHopState.Utility.AutoEquipModeHold = false
			end
			autoServerHopState.Utility.AutoEquipBestBrainrot =
				autoServerHopState.Utility.AutoEquipModeHold == true
				or autoServerHopState.Utility.AutoEquipModeMount == true
				or autoServerHopState.Utility.AutoEquipModeHoldMount == true
			local gameFallbacks = autoServerHopState.Utility.FallbackGameChoices
			if type(gameFallbacks) == "table" then
				gameFallbacks[autoServerHopState.Utility.GameToChoose] = nil
			end
			local roundFallbacks = autoServerHopState.Utility.FallbackRoundChoices
			if type(roundFallbacks) == "table" then
				roundFallbacks[tostring(
					autoServerHopState.Utility.RoundsToChoose
				)] = nil
			end
			return true
		end
		local function applyProfileSnapshot(profile)
			if type(profile) ~= "table" then return false end
			local globalPause = autoServerHopState.Utility.PauseScript == true
			local toggleRegistry = autoServerHopState.RuntimeUtilityToggleRows
			local joinedBlacklist = copyJsonSafe(autoServerHopState.JoinedServerBlacklist) or {}
			local canceledCounts = copyJsonSafe(autoServerHopState.CanceledTradeCounts) or {}
			local recentServers = copyJsonSafe(autoServerHopState.RecentServerIds) or {}
			local permanentBlacklisted = copyJsonSafe(
				autoServerHopState.Utility.PermanentBlacklistedUserIds
			) or {}
			-- Reset the live schema before applying a profile so empty tables in one
			-- profile cannot inherit selections from the other profile.
			table.clear(minigameAutoplayState)
			table.clear(autoOfferState)
			table.clear(regularAutoOfferState)
			table.clear(autoAcceptState)
			table.clear(tradeRequestCriteriaState)
			table.clear(autoSitState)
			table.clear(autoCancelState)
			mergeInto(minigameAutoplayState, defaultSnapshot.MinigameAutoplay)
			mergeInto(autoOfferState, defaultSnapshot.AutoOffer)
			mergeInto(regularAutoOfferState, defaultSnapshot.RegularAutoOffer)
			mergeInto(autoAcceptState, defaultSnapshot.AutoAccept)
			mergeInto(tradeRequestCriteriaState, defaultSnapshot.TradeRequestCriteria)
			mergeInto(autoSitState, defaultSnapshot.AutoSit)
			mergeInto(autoCancelState, defaultSnapshot.AutoCancel)
			local defaultServerHop = defaultSnapshot.ServerHop or {}
			autoServerHopState.Enabled = defaultServerHop.Enabled == true
			autoServerHopState.ServerTimeEnabled = defaultServerHop.ServerTimeEnabled == true
			autoServerHopState.ServerTime = tonumber(defaultServerHop.ServerTime) or 10
			autoServerHopState.TimeSinceLastGameEnabled = defaultServerHop.TimeSinceLastGameEnabled == true
			autoServerHopState.TimeSinceLastGame = tonumber(defaultServerHop.TimeSinceLastGame) or 3
			autoServerHopState.WinWagerTimeAdded = tonumber(defaultServerHop.WinWagerTimeAdded) or 3
			autoServerHopState.BoothPurchaseTimeAdded = tonumber(defaultServerHop.BoothPurchaseTimeAdded) or 1
			autoServerHopState.LeaveIfScriptUserInServer = defaultServerHop.LeaveIfScriptUserInServer == true
			autoServerHopState.ServerBlacklistMinutes = tonumber(defaultServerHop.ServerBlacklistMinutes) or 10
			local defaultUtility = defaultServerHop.Utility or {}
			for _, key in ipairs(utilityKeys) do
				autoServerHopState.Utility[key] = copyJsonSafe(defaultUtility[key])
			end
			local ok = applySnapshot(profile)
			autoServerHopState.JoinedServerBlacklist = joinedBlacklist
			autoServerHopState.CanceledTradeCounts = canceledCounts
			autoServerHopState.RecentServerIds = recentServers
			autoServerHopState.Utility.PermanentBlacklistedUserIds = permanentBlacklisted
			-- Pause Script is global, not profile-specific. Switching between Regular
			-- and Simple Autofarm must never silently unpause or pause the script.
			autoServerHopState.Utility.PauseScript = globalPause
			autoServerHopState.RuntimeCanceledTradeCounts = copyJsonSafe(canceledCounts) or {}
			if type(toggleRegistry) == "table" and next(toggleRegistry) ~= nil then
				autoServerHopState.RuntimeUtilityToggleRows = toggleRegistry
			end
			return ok
		end
		local SIMPLE_AUTOFARM_PROFILE_VERSION = 4
		local function migrateSimpleAutofarmProfile(simple)
			if type(simple) ~= "table" or type(simple.Profile) ~= "table" then return end
			local version = math.floor(tonumber(simple.Version) or 1)
			if version >= SIMPLE_AUTOFARM_PROFILE_VERSION then return end
			local profile = simple.Profile
			local serverHop = type(profile.ServerHop) == "table" and profile.ServerHop or nil
			local utility = serverHop and type(serverHop.Utility) == "table" and serverHop.Utility or nil
			if not serverHop or not utility then return end
			-- Keep-running defaults from earlier profile versions. These settings are
			-- required for Simple Autofarm to continue finding/starting matches.
			serverHop.Enabled = true
			serverHop.LeaveIfScriptUserInServer = true
			utility.AutoReconnect = true
			utility.PrintWinsLossesToTerminal = true
			utility.PrintKicksToTerminal = true
			utility.AutoCancelTradeTimeoutEnabled = true
			utility.AutoCancelTradeTimeout = 30
			utility.AutoCancelNoValueTimeoutEnabled = true
			utility.AutoCancelNoValueTimeout = 15
			utility.AutoOfferLowestTokensToMatch = 10
			local autoSit = type(profile.AutoSit) == "table" and profile.AutoSit or nil
			local emptyTables = autoSit and type(autoSit.EmptyTables) == "table"
				and autoSit.EmptyTables or nil
			if emptyTables then
				emptyTables.Enabled = true
			end
			-- v4: Eternal is never offered from inventory. It is bought with
			-- six Paradox plus exactly 250,000 tokens.
			local autoOffer = type(profile.AutoOffer) == "table" and profile.AutoOffer or nil
			local eternal = autoOffer and type(autoOffer.Eternal) == "table" and autoOffer.Eternal or nil
			if eternal then
				eternal.Enabled = true
				eternal.OfferModeRarity = true
				eternal.OfferModeSpecific = false
				eternal.Targets = {Paradox = true}
				eternal.Amounts = {Paradox = 6}
				eternal.SpecificTargets = {}
				eternal.Tokens = 250000
				eternal.OfferAllTokens = false
			end
			utility.FallbackTokensEternal = 250000
			utility.FallbackEternalOfferAllTokens = false
		end
		local function loadSettingsEnvelope(saved)
			if type(saved) ~= "table" then return false end
			local savedGlobalPause = type(saved.GlobalPauseScript) == "boolean"
				and saved.GlobalPauseScript or nil
			applySnapshot(saved)
			regularProfileSnapshot = snapshotSettings()
			local simple = saved.SimpleAutofarm
			migrateSimpleAutofarmProfile(simple)
			if type(simple) == "table" and type(simple.Profile) == "table" then
				simpleAutofarmProfile = copyJsonSafe(simple.Profile)
			end
			autoServerHopState.Utility.SimpleAutofarmEnabled = false
			-- Persisted enable state is authoritative. Inventory replication is often
			-- unavailable for a short window during auto-execute/teleport startup;
			-- never interpret that transient state as the user disabling Autofarm.
			if type(simple) == "table" and simple.Enabled == true then
				-- Backward compatibility: old saves stored Pause Script only inside
				-- the active profile. Capture it before profile application preserves
				-- the current global value.
				if savedGlobalPause == nil
					and type(simple.Profile) == "table"
					and type(simple.Profile.ServerHop) == "table"
					and type(simple.Profile.ServerHop.Utility) == "table"
					and type(simple.Profile.ServerHop.Utility.PauseScript) == "boolean"
				then
					savedGlobalPause = simple.Profile.ServerHop.Utility.PauseScript
				end
				applyProfileSnapshot(simpleAutofarmProfile or buildSimpleAutofarmDefaultSnapshot())
				autoServerHopState.Utility.SimpleAutofarmEnabled = true
			end
			if savedGlobalPause ~= nil then
				autoServerHopState.Utility.PauseScript = savedGlobalPause
			end
			return true
		end
		-- Load both durable copies and choose the newest valid one. This prevents
		-- a valid-but-stale primary file from beating a newer backup when a write
		-- was interrupted during teleport or manual re-execution.
		local function readSettingsFile(path)
			if not readFile then return nil end
			local okRead, encoded = pcall(readFile, path)
			if not okRead or type(encoded) ~= "string" or encoded == "" then return nil end
			local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, encoded)
			return okDecode and type(decoded) == "table" and decoded or nil
		end
		local primarySnapshot = readSettingsFile(SETTINGS_FILE)
		local backupSnapshot = readSettingsFile(SETTINGS_BACKUP_FILE)
		local diskSnapshot = primarySnapshot
		if type(backupSnapshot) == "table" then
			local primarySavedAt = type(primarySnapshot) == "table" and tonumber(primarySnapshot._SavedAt) or -1
			local backupSavedAt = tonumber(backupSnapshot._SavedAt) or -1
			if type(primarySnapshot) ~= "table" or backupSavedAt > primarySavedAt then
				diskSnapshot = backupSnapshot
			end
		end
		local memorySnapshot = rawget(_G, MEMORY_KEY)
		pcall(function()
			if getgenv and type(getgenv()[MEMORY_KEY]) == "table" then
				memorySnapshot = getgenv()[MEMORY_KEY]
			end
		end)
		-- Use the newest durable/in-memory snapshot instead of blindly loading
		-- process memory after disk. This prevents a stale executor-global table
		-- from rolling back a newer file after a re-execution. Untimestamped
		-- memory is used only when no durable snapshot exists (for executors
		-- without filesystem APIs).
		local chosenSnapshot = diskSnapshot
		if type(memorySnapshot) == "table" then
			local memorySavedAt = tonumber(memorySnapshot._SavedAt)
			local diskSavedAt = type(diskSnapshot) == "table" and tonumber(diskSnapshot._SavedAt) or nil
			if type(diskSnapshot) ~= "table"
				or (memorySavedAt ~= nil and (diskSavedAt == nil or memorySavedAt >= diskSavedAt))
			then
				chosenSnapshot = memorySnapshot
			end
		end
		if type(chosenSnapshot) == "table" then loadSettingsEnvelope(chosenSnapshot) end
		if not regularProfileSnapshot then regularProfileSnapshot = snapshotSettings() end
		local function stripTransientSettings(snapshot)
			if type(snapshot) ~= "table" then return snapshot end
			local serverHop = snapshot.ServerHop
			local utility = type(serverHop) == "table" and serverHop.Utility or nil
			if type(utility) == "table" then
				utility.UndoAllSettings = nil
				utility.AutoChatEditing = nil
				utility.AutoTradeChatEditing = nil
			end
			return snapshot
		end
		local function settingsEnvelopeForSave()
			local current = stripTransientSettings(snapshotSettings())
			if autoServerHopState.Utility.SimpleAutofarmEnabled == true then
				simpleAutofarmProfile = copyJsonSafe(current)
			else
				regularProfileSnapshot = copyJsonSafe(current)
			end
			local envelope = stripTransientSettings(copyJsonSafe(regularProfileSnapshot or current) or current)
			local profile = stripTransientSettings(copyJsonSafe(simpleAutofarmProfile or buildSimpleAutofarmDefaultSnapshot()))
			envelope.SimpleAutofarm = {
				Version = SIMPLE_AUTOFARM_PROFILE_VERSION,
				Enabled = autoServerHopState.Utility.SimpleAutofarmEnabled == true,
				Profile = profile,
			}
			-- Keep Pause Script as one global persisted switch independent of the
			-- Regular/Simple Autofarm profiles.
			envelope.GlobalPauseScript = autoServerHopState.Utility.PauseScript == true
			return envelope
		end
		local function saveSettings(forceDisk)
			local snapshot = settingsEnvelopeForSave()
			local savedAt = DateTime.now().UnixTimestampMillis
			local stampedSnapshot = copyJsonSafe(snapshot) or snapshot
			stampedSnapshot._SavedAt = savedAt
			rawset(_G, MEMORY_KEY, stampedSnapshot)
			pcall(function()
				if getgenv then getgenv()[MEMORY_KEY] = stampedSnapshot end
			end)
			local ok, encoded = pcall(function()
				return HttpService:JSONEncode(snapshot)
			end)
			if not ok or type(encoded) ~= "string" then return false end
			if encoded == lastEncoded and not forceDisk then return true end
			if not writeFile then
				lastEncoded = encoded
				return true
			end
			local now = os.clock()
			if forceDisk or now - lastDiskWriteAt >= 0.20 then
				local diskSnapshot = stampedSnapshot
				local okDiskEncode, diskEncoded = pcall(HttpService.JSONEncode, HttpService, diskSnapshot)
				if not okDiskEncode or type(diskEncoded) ~= "string" then return false end
				-- Write both copies independently. A primary write interrupted by a
				-- teleport/re-execution must not destroy the last durable settings.
				local wroteBackup = pcall(writeFile, SETTINGS_BACKUP_FILE, diskEncoded)
				local wroteMain = pcall(writeFile, SETTINGS_FILE, diskEncoded)
				if wroteMain or wroteBackup then
					rawset(_G, MEMORY_KEY, diskSnapshot)
					pcall(function() if getgenv then getgenv()[MEMORY_KEY] = diskSnapshot end end)
					lastDiskWriteAt = now
					lastEncoded = encoded
					return true
				end
			end
			return false
		end
		local function refreshSettingsUiSoon()
			autoServerHopState.RuntimeSettingsResetEpoch =
				(tonumber(autoServerHopState.RuntimeSettingsResetEpoch) or 0) + 1
			task.defer(function()
				local refresh = rawget(_G, "__TUFFHUB_REFRESH_ALL_SETTINGS_UI")
				if type(refresh) == "function" then pcall(refresh) end
			end)
		end
		local function showSimpleAutofarmWarning()
			autoServerHopState.RuntimeSimpleAutofarmWarningUntil = os.clock() + 5
			local show = rawget(_G, "__TUFFHUB_SHOW_SIMPLE_AUTOFARM_WARNING")
			if type(show) == "function" then pcall(show) end
		end
		local function setSimpleAutofarmEnabled(enabled)
			enabled = enabled == true
			local currentlyEnabled = autoServerHopState.Utility.SimpleAutofarmEnabled == true
			if enabled == currentlyEnabled then
				saveSettings(true)
				return true
			end
			if enabled and autoServerHopState.HasAnyBrainrot() == false then
				autoServerHopState.Utility.SimpleAutofarmEnabled = false
				showSimpleAutofarmWarning()
				refreshSettingsUiSoon()
				return false
			end
			if enabled then
				regularProfileSnapshot = copyJsonSafe(snapshotSettings())
				applyProfileSnapshot(simpleAutofarmProfile or buildSimpleAutofarmDefaultSnapshot())
				autoServerHopState.Utility.SimpleAutofarmEnabled = true
			else
				simpleAutofarmProfile = copyJsonSafe(snapshotSettings())
				applyProfileSnapshot(regularProfileSnapshot or defaultSnapshot)
				autoServerHopState.Utility.SimpleAutofarmEnabled = false
			end
			autoServerHopState.RuntimeSimpleAutofarmTargetRarity = nil
			autoServerHopState.RuntimePlayedMinigameUserIds = {}
			refreshSettingsUiSoon()
			saveSettings(true)
			return true
		end
		local function resetSimpleAutofarmSettings()
			simpleAutofarmProfile = buildSimpleAutofarmDefaultSnapshot()
			if autoServerHopState.Utility.SimpleAutofarmEnabled == true then
				applyProfileSnapshot(simpleAutofarmProfile)
				autoServerHopState.Utility.SimpleAutofarmEnabled = true
				autoServerHopState.RuntimeSimpleAutofarmTargetRarity = nil
				autoServerHopState.RuntimePlayedMinigameUserIds = {}
			end
			refreshSettingsUiSoon()
			saveSettings(true)
			return true
		end
		rawset(_G, "__TUFFHUB_SET_SIMPLE_AUTOFARM", setSimpleAutofarmEnabled)
		rawset(_G, "__TUFFHUB_RESET_SIMPLE_AUTOFARM", resetSimpleAutofarmSettings)
		local function resetAllSettingsState()
			if autoServerHopState.Utility.SimpleAutofarmEnabled == true then
				return resetSimpleAutofarmSettings()
			end
			local defaults = defaultSnapshot
			if type(defaults) ~= "table" then return false end
			table.clear(minigameAutoplayState)
			table.clear(autoOfferState)
			table.clear(regularAutoOfferState)
			table.clear(autoAcceptState)
			table.clear(tradeRequestCriteriaState)
			table.clear(autoSitState)
			table.clear(autoCancelState)
			mergeInto(minigameAutoplayState, defaults.MinigameAutoplay)
			mergeInto(autoOfferState, defaults.AutoOffer)
			mergeInto(regularAutoOfferState, defaults.RegularAutoOffer)
			mergeInto(autoAcceptState, defaults.AutoAccept)
			mergeInto(tradeRequestCriteriaState, defaults.TradeRequestCriteria)
			mergeInto(autoSitState, defaults.AutoSit)
			mergeInto(autoCancelState, defaults.AutoCancel)
			local defaultServerHop = defaults.ServerHop or {}
			autoServerHopState.Enabled = defaultServerHop.Enabled == true
			autoServerHopState.ServerTimeEnabled = defaultServerHop.ServerTimeEnabled == true
			autoServerHopState.ServerTime = tonumber(defaultServerHop.ServerTime) or 10
			autoServerHopState.TimeSinceLastGameEnabled = defaultServerHop.TimeSinceLastGameEnabled == true
			autoServerHopState.TimeSinceLastGame = tonumber(defaultServerHop.TimeSinceLastGame) or 3
			autoServerHopState.WinWagerTimeAdded = tonumber(defaultServerHop.WinWagerTimeAdded) or 3
			autoServerHopState.BoothPurchaseTimeAdded = tonumber(defaultServerHop.BoothPurchaseTimeAdded) or 1
			autoServerHopState.LeaveIfScriptUserInServer = defaultServerHop.LeaveIfScriptUserInServer == true
			autoServerHopState.ServerBlacklistMinutes =
				math.clamp(math.floor(tonumber(defaultServerHop.ServerBlacklistMinutes) or 10), 1, 60)
			autoServerHopState.JoinedServerBlacklist = {}
			autoServerHopState.CanceledTradeCounts = {}
			autoServerHopState.RecentServerIds = {}
			autoServerHopState.RuntimeTempBlacklistedUserIds = {}
			autoServerHopState.RuntimeCanceledTradeCounts = {}
			autoServerHopState.RuntimeCanceledTradeLastCountAt = {}
			autoServerHopState.RuntimeServerHopPending = false
			local defaultUtility = defaultServerHop.Utility or {}
			for _, key in ipairs(utilityKeys) do
				autoServerHopState.Utility[key] = copyJsonSafe(defaultUtility[key])
			end
			autoServerHopState.Utility.UndoAllSettings = false
			autoServerHopState.Utility.AutoChatEditing = false
			autoServerHopState.Utility.AutoTradeChatEditing = false
			autoServerHopState.Utility.AutoChatMessageRevision = 0
			autoServerHopState.Utility.AutoTradeMessageRevision = 0
			autoServerHopState.Utility._LastTradeMessageGuid = nil
			autoServerHopState.Utility._LastTradeMessageSentAt = nil
			autoServerHopState.RuntimeStartedAt = os.clock()
			autoServerHopState.RuntimeSettingsResetEpoch =
				(tonumber(autoServerHopState.RuntimeSettingsResetEpoch) or 0) + 1
			rawset(_G, MEMORY_KEY, nil)
			return saveSettings(true)
		end
		rawset(_G, "__TUFFHUB_RESET_ALL_SETTINGS_STATE", resetAllSettingsState)
		rawset(_G, SAVE_KEY, saveSettings)
		pcall(function()
			if getgenv then getgenv()[SAVE_KEY] = saveSettings end
		end)
		-- Save as soon as Roblox begins any teleport. The generation guard prevents
		-- stale callbacks from older re-executions from touching current settings.
		pcall(function()
			startupPlayer.OnTeleport:Connect(function()
				if rawget(_G, GENERATION_KEY) == generation then
					pcall(saveSettings, true)
				end
			end)
		end)
		saveSettings(false)
		-- UI commits save immediately; this low-frequency flush only catches programmatic edits.
		task.spawn(function()
			-- UI commits and departures already force-save. This only catches
			-- programmatic edits, so keep it low-frequency to avoid repeated deep
			-- copies/JSON allocations during long sessions.
			while rawget(_G, GENERATION_KEY) == generation do
				task.wait(10)
				saveSettings(false)
			end
		end)
	end)()
	autoServerHopState.ApplyPauseState = function(paused)
		paused = paused == true
		if not paused then return end
		-- A global pause must cancel pending script actions immediately, not only
		-- prevent the next scheduler tick. Keep user configuration untouched.
		autoServerHopState.RuntimeServerHopPending = false
		autoServerHopState.RuntimeScriptUserHopRequested = false
		autoServerHopState.RuntimeCheckServerHopRequested = false
		autoServerHopState.RuntimeManualServerHopRequested = false
		autoServerHopState.RuntimeAutoSitBusy = false
		autoServerHopState.RuntimeBoothMutationBusy = false
		pcall(function()
			local player = Players.LocalPlayer
			local character = player and player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if humanoid then
				humanoid:Move(Vector3.zero, false)
				if root then humanoid:MoveTo(root.Position) end
			end
		end)
	end
	if autoServerHopState.Utility.PauseScript == true then
		task.defer(autoServerHopState.ApplyPauseState, true)
	end
end
