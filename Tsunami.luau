local function createSidebarItem(
	name,
	order,
	fallbackGlyph
)
	local row = New("Frame")
	row.Name = name .. "Row"
	row.LayoutOrder = order
	row.Size = U2(1, 0, 0, UI.MENU_ITEM_HEIGHT)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
