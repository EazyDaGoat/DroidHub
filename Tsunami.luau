		local function waitMutationSlotAB()
			while screenGui.Parent and autoServerHopState.Utility.AutoBooth == true do
				if not boothMutationAllowedAB() then return false end
				local remaining = nextMutationAtAB - os.clock()
				if remaining <= 0 then
