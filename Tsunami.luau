							or item.name
							or (item.sub and item.sub.name)
							or item.displayName
							or item.DisplayName
							or ""
					)
					if name ~= "" then names[name] = true end
				end
			end
		end)
		local options = {}
		for name in pairs(names) do options[#options + 1] = name end
		table.sort(options, function(a, b)
			return string.lower(a) < string.lower(b)
		end)
		return options
	end
