					end
					if u.RegularFallbackToBestAvailableBrainrots==true then
						goal=math.max(goal,math.clamp(math.floor(tonumber(u.RegularFallbackBestAvailableBrainrotAmount) or 6),1,6))
					end
					if u.RegularFallbackToSpecificItems==true then goal=math.max(goal,math.min(6,selectedCount)) end
					local remaining=math.max(0,goal-request.ExactAdded)
					local targetIndex=table.find(OUTGOING_BRAINROT_RARITY_OPTIONS,request.TargetRarity)
					if not targetIndex then
						local fullIndex=table.find(BRAINROT_RARITY_OPTIONS,request.TargetRarity)
						if fullIndex then targetIndex=math.min(fullIndex,#OUTGOING_BRAINROT_RARITY_OPTIONS+1) end
					end
					for _,mode in ipairs(fallbackOrder) do
						if remaining<=0 then break end
						if mode=="Specific Items" and u.RegularFallbackToSpecificItems==true then
							local before=#desired
							addSelectedInInventoryOrder(selected,remaining,nil,nil,nil)
							remaining-=math.max(0,#desired-before)
						elseif mode=="Next Higher Rarity" and u.RegularFallbackToNextHigherRarityBrainrot==true and targetIndex then
							for higherIndex=targetIndex+1,#OUTGOING_BRAINROT_RARITY_OPTIONS do
								if remaining<=0 or #desired>=6 then break end
								remaining-=addRarity(OUTGOING_BRAINROT_RARITY_OPTIONS[higherIndex],remaining,true)
							end
						elseif mode=="Next Lower Rarity" and u.RegularFallbackOffers==true and targetIndex then
							for lowerIndex=math.min(targetIndex-1,#OUTGOING_BRAINROT_RARITY_OPTIONS),1,-1 do
								if remaining<=0 or #desired>=6 then break end
								remaining-=addRarity(OUTGOING_BRAINROT_RARITY_OPTIONS[lowerIndex],remaining,true)
							end
						elseif mode=="Best Available Brainrots" and u.RegularFallbackToBestAvailableBrainrots==true then
							for rarityIndex=#OUTGOING_BRAINROT_RARITY_OPTIONS,1,-1 do
								if remaining<=0 or #desired>=6 then break end
								remaining-=addRarity(OUTGOING_BRAINROT_RARITY_OPTIONS[rarityIndex],remaining,false)
							end
						elseif mode=="Token Fallback" and u.RegularFallbackToTokens==true then
							if u["RegularFallback"..request.SourceRarity.."OfferAllTokens"]==true then
								forceAllTokens=true
							else
								tokens+=math.max(0,math.floor(tonumber(u["RegularFallbackTokens"..request.SourceRarity]) or 0))
							end
							remaining=0
						end
					end
				end
			end

			local reactiveMatched=false
			local chatRule=matchingRegularTradeChatOffer(u)
			if chatRule then
				reactiveMatched=true
				local targets=type(chatRule.Targets)=="table" and chatRule.Targets or {}; local amounts=type(chatRule.Amounts)=="table" and chatRule.Amounts or {}
				addSelectedInInventoryOrder(type(chatRule.SpecificItems)=="table" and chatRule.SpecificItems or {},nil,nil,nil,nil)
				for _,target in ipairs(OUTGOING_BRAINROT_RARITY_OPTIONS) do if targets[target]==true and #desired<6 then addRarity(target,math.clamp(math.floor(tonumber(amounts[target]) or 1),1,6),false) end end
				tokens=math.max(0,math.floor(tonumber(chatRule.TokenAmount) or 0)); forceAllTokens=chatRule.OfferAllTokens==true
			else
				local opponent=offeredItems("player2"); local sourceCounts={}
				for _,item in ipairs(opponent) do local r=rarity(item); if r then sourceCounts[r]=(sourceCounts[r] or 0)+1 end end
				if u.AdaptiveCriteriaApplyRegularOffers==true then
					local rules=type(u.AdaptiveRegularOfferSpecificItems)=="table" and u.AdaptiveRegularOfferSpecificItems or {}
					local adaptiveFloor
					for _,r in ipairs(BRAINROT_RARITY_OPTIONS) do
						local cfg=regularAutoOfferState[r]
						if type(cfg)=="table" and cfg.Enabled==true then adaptiveFloor=r break end
					end
					if adaptiveFloor then
						local extra=0
						for _,item in ipairs(opponent) do
							local actual=rarity(item); local actualCfg=actual and regularAutoOfferState[actual] or nil
							if not (type(actualCfg)=="table" and actualCfg.Enabled==true) then
								for _,rule in ipairs(rules) do
									if type(rule)=="table" and rule.Item~=nil and tostring(rule.Item)~="" and specificRuleMatches(item,rule) then extra+=1 break end
								end
							end
						end
						if extra>0 then sourceCounts[adaptiveFloor]=(sourceCounts[adaptiveFloor] or 0)+extra end
					end
				end
				local opponentTokens=math.max(0,math.floor(tonumber(try(Negotiation,{"player2","currency"})) or 0))
				local primaryQualified=false
				if u.RegularAutoOfferMaster==true then
					for _,sourceRarity in ipairs(BRAINROT_RARITY_OPTIONS) do
						local config=regularAutoOfferState[sourceRarity]
						if (sourceCounts[sourceRarity] or 0)>0 and type(config)=="table" and config.Enabled==true
							and config.AlongsideOnly~=true and autoServerHopState.AutoOfferConfigHasResponse(config)
						then primaryQualified=true break end
					end
				end
				if u.RegularAutoOfferTokensEnabled==true then
					if u.RegularAutoOfferMatchTokensWithTokens==true then
						local minimum=math.clamp(math.floor(tonumber(u.RegularAutoOfferLowestTokensToMatch) or 1),1,1000000)
						if opponentTokens>=minimum then primaryQualified=true end
					end
					local tokenTarget=u.RegularAutoOfferTokenRarity; local tokenUnit=math.clamp(math.floor(tonumber(u.RegularAutoOfferTokenAmount) or 0),0,1000000)
					if u.RegularAutoOfferMatchTokensWithBrainrots==true and tokenUnit>0 and table.find(OUTGOING_BRAINROT_RARITY_OPTIONS,tokenTarget)
						and math.floor(opponentTokens/tokenUnit)>0
					then primaryQualified=true end
				end
				if u.RegularAutoOfferMaster==true then
					for _,sourceRarity in ipairs(BRAINROT_RARITY_OPTIONS) do
						local sourceCount=sourceCounts[sourceRarity] or 0; local config=regularAutoOfferState[sourceRarity]
						if sourceCount>0 and type(config)=="table" and config.Enabled==true
							and (config.AlongsideOnly~=true or primaryQualified)
						then
							local sourceConfigured=false
							if config.OfferModeRarity~=false then
								local perItemTokens=math.clamp(math.floor(tonumber(config.Tokens) or 0),0,1000000)
								if perItemTokens>0 or config.OfferAllTokens==true then sourceConfigured=true end
								for occurrence=1,sourceCount do
									tokens+=perItemTokens; if config.OfferAllTokens==true then forceAllTokens=true end
									for _,target in ipairs(OUTGOING_BRAINROT_RARITY_OPTIONS) do
										if config.Targets and config.Targets[target]==true then
											sourceConfigured=true; local need=math.clamp(math.floor(tonumber(config.Amounts and config.Amounts[target]) or 1),1,6)
											local got=addRarity(target,need,false); if got<need then applyFallback(sourceRarity,target,got) end
										end
									end
								end
							end
							if config.OfferModeSpecific==true and type(config.SpecificTargets)=="table" then
								local added=addSelectedInInventoryOrder(config.SpecificTargets,nil,nil,nil,nil); if added>0 then sourceConfigured=true end
							end
							if sourceConfigured then reactiveMatched=true end
						end
					end
				end
				if u.RegularAutoOfferTokensEnabled==true then
					if u.RegularAutoOfferMatchTokensWithTokens==true then
						local minimum=math.clamp(math.floor(tonumber(u.RegularAutoOfferLowestTokensToMatch) or 1),1,1000000)
						if opponentTokens>=minimum then tokens+=opponentTokens*math.clamp(math.floor(tonumber(u.RegularAutoOfferTokenAddRatio) or 1),1,10); reactiveMatched=true end
					end
					local target=u.RegularAutoOfferTokenRarity; local unit=math.clamp(math.floor(tonumber(u.RegularAutoOfferTokenAmount) or 0),0,1000000)
					if u.RegularAutoOfferMatchTokensWithBrainrots==true and unit>0 and table.find(OUTGOING_BRAINROT_RARITY_OPTIONS,target) then
						local units=math.floor(opponentTokens/unit); if units>0 then addRarity(target,units,false); reactiveMatched=true end
					end
				end
			end
			applyQueuedFallbacks()
			if not reactiveMatched then
				-- Opening Offer is the only baseline. When a reactive rule stops matching,
				-- return to that baseline instead of retaining a stale reactive offer.
				if u.RegularOpeningAutoshowBestBrainrots==true
					or u.RegularOpeningCustomBrainrots==true
					or u.RegularOpeningAutoshowAllTokens==true
					or u.RegularOpeningCustomTokens==true
				then
					return applyOpeningOffer(u)
				end
				return syncOwnOffer(u,{},0)
			end
			tokens=forceAllTokens and balance or math.min(balance,math.max(0,math.floor(tokens)))
			return syncOwnOffer(u,desired,tokens)
		end
		local function regularOfferAutomationEnabled(u)
			return u.RegularAutoOfferMaster==true
				or u.RegularAutoOfferTokensEnabled==true
				or u.RegularAutoOfferBasedOnTradeChat==true
				or u.RegularOpeningAutoshowBestBrainrots==true
				or u.RegularOpeningCustomBrainrots==true
				or u.RegularOpeningAutoshowAllTokens==true
				or u.RegularOpeningCustomTokens==true
		end
		local function acceptRequirements(u)
			local items=offeredItems("player2"); local counts={}; local enabled=0; local matched=0
			local adaptiveAccept = u.AdaptiveCriteriaApplyAcceptOffers == true
			for _,it in ipairs(items) do local r=rarity(it); if r and (adaptiveAccept or selectedFilterMatches(it,u["AutoAccept"..r.."Mutations"],u["AutoAccept"..r.."Traits"],{Signatures=u["AutoAccept"..r.."Signatures"],Sizes=u["AutoAccept"..r.."Sizes"],Levels=u["AutoAccept"..r.."Levels"],MinimumTraits=u["AutoAccept"..r.."MinimumTraits"]})) then counts[r]=(counts[r] or 0)+1 end end
			for _,r in ipairs(BRAINROT_RARITY_OPTIONS) do local cfg=autoAcceptState[r]; if cfg and cfg.Enabled==true then enabled+=1; local wanted=adaptiveAccept and 1 or math.clamp(math.floor(tonumber(cfg.Amount) or 1),1,6); if (counts[r] or 0)>=wanted then matched+=1 end end end
			local tokenCfg=autoAcceptState.Tokens; local offeredTokens=math.max(0,math.floor(tonumber(try(Negotiation,{"player2","currency"})) or 0))
			if tokenCfg and tokenCfg.Enabled==true then enabled+=1; if offeredTokens>=math.clamp(math.floor(tonumber(tokenCfg.Amount) or 1),1,1000000) then matched+=1 end end
			for _,rule in ipairs(type(u.AutoAcceptSpecificItems)=="table" and u.AutoAcceptSpecificItems or {}) do if type(rule)=="table" and rule.Item~=nil and tostring(rule.Item)~="" then enabled+=1; local hit=false; for _,it in ipairs(items) do if specificRuleMatches(it,rule) then hit=true break end end; if hit then matched+=1 end end end
			if enabled==0 then return false,false end
			local ok=(u.AutoAcceptMustHaveAll==true and matched==enabled) or (u.AutoAcceptMustHaveOne==true and matched>0)
			return ok,true
		end
		local function outgoingRequestPending(requests)
			if type(requests) ~= "table" then return false end
			local myId = tostring(localPlayer.UserId)
			for key, request in pairs(requests) do
				if type(request) == "table"
					and request.gift ~= true
					and tostring(key) == myId
					and tostring(request.targetPlayer or "") ~= myId
				then
					return true
				end
			end
			return false
		end
		local function bestAutoSendPlayer(u, requests)
			local matcher = autoServerHopState.PlayerEligibleForRegularTradeSend
			if type(matcher) ~= "function" then return nil end
			local now = os.clock()
			local scorer = autoServerHopState.PublicPlayerPriorityScore
			local best, bestScore
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= localPlayer
					and now >= (tonumber(outgoingTradeCooldowns[tostring(player.UserId)]) or 0)
				then
					local incoming = type(requests) == "table"
						and requests[tostring(player.UserId)]
						or nil
					if not (
						type(incoming) == "table"
						and incoming.targetPlayer == tostring(localPlayer.UserId)
						and incoming.gift ~= true
					) then
						local okEligible, eligible = pcall(matcher, player)
						if okEligible and eligible == true then
							local score = type(scorer) == "function"
								and scorer(player, u.AutoSendTradeSpecificItems)
								or 0
							if not best or score > bestScore then
								best, bestScore = player, score
							end
						end
					end
				end
			end
			return best
		end
		local function tryAutoSendTrade(u, requests)
			if u.AutoSendTradesEnabled ~= true
				or u.PauseScript == true
				or autoServerHopState.RuntimeServerHopPending == true
				or outgoingRequestPending(requests)
				or isNormalTrade() ~= nil
			then
				return false
			end
			local now = os.clock()
			if now < autoSendPendingUntil
				or now - lastAutoSendAttempt < 1.00
			then
				return false
			end
			local player = bestAutoSendPlayer(u, requests)
			if not player then return false end
			lastAutoSendAttempt = now
			local retrySeconds = math.clamp(
				tonumber(u.AutoSendTradeRetrySeconds) or 30,
				5,
				120
			)
			local ok, result = pcall(SendTrade.InvokeServer, SendTrade, player)
			local success = ok and result ~= false
			outgoingTradeCooldowns[tostring(player.UserId)] =
				os.clock() + (success and retrySeconds or 3)
			if success then
				autoSendPendingUntil = os.clock() + 5.00
			end
			return success
		end
		while screenGui.Parent do
			local u=autoServerHopState.Utility
			if u.PauseScript==true or autoServerHopState.RuntimeServerHopPending == true then
				releaseAutomatedReady()
				rawset(_G,"__DROIDHUB_NORMAL_TRADE_AUTOMATION_GUID",nil)
				lastGuid=nil; openingAppliedGuid=nil; table.clear(opponentItemCache)
				task.wait(0.30); continue
			end
			local regularAutomationActive = u.AutoAcceptTradesAcceptRequests==true
				or u.AutoAcceptTradesAcceptOffers==true
				or u.AutoSendTradesEnabled==true
				or autoServerHopState.NoRegularTradeEnabled==true
				or regularOfferAutomationEnabled(u)
			if not regularAutomationActive then
				releaseAutomatedReady()
				rawset(_G,"__DROIDHUB_NORMAL_TRADE_AUTOMATION_GUID",nil)
				lastGuid=nil; openingAppliedGuid=nil; autoReadyGuid=nil
				table.clear(opponentItemCache)
				task.wait(0.75)
				continue
			end

			local requests=try(TradeRequests,{})
			local liveRequestKeys={}
			local eligibleRequests={}
			if type(requests)=="table" then
				for key,req in pairs(requests) do
					local requestKey=tostring(key)
					liveRequestKeys[requestKey]=true
					if type(req)=="table"
						and req.targetPlayer==tostring(localPlayer.UserId)
						and req.gift~=true
					then
						autoServerHopState.RuntimeLastRegularTradeActivityAt = os.clock()
					end
					if u.AutoAcceptTradesAcceptRequests==true
						and autoServerHopState.RuntimeServerHopPending ~= true
						and type(req)=="table"
						and req.targetPlayer==tostring(localPlayer.UserId)
						and req.gift~=true
						and not handledRequests[requestKey]
					then
						local opponentId=tonumber(key)
						local opponent=opponentId and Players:GetPlayerByUserId(opponentId) or nil
						local requestOK,configured=tradeRequestRequirements(u,opponent)
						if configured and requestOK then
							local scorer=autoServerHopState.PublicPlayerPriorityScore
							eligibleRequests[#eligibleRequests+1]={Key=key,RequestKey=requestKey,Player=opponent,Score=type(scorer)=="function" and scorer(opponent,u.AutoAcceptTradesRequestSpecificItems) or 0}
						end
					end
				end
			end
			if #eligibleRequests>0 then
				table.sort(eligibleRequests,function(a,b)
					if a.Score~=b.Score then return a.Score>b.Score end
					return tostring(a.RequestKey)<tostring(b.RequestKey)
				end)
				local chosen=eligibleRequests[1]
				handledRequests[chosen.RequestKey]=true
				local delay=tradeDelay(u,"AutoAcceptTradesInitialDelay",1.75)
				if delay>0 then task.wait(delay) end
				if u.PauseScript ~= true and autoServerHopState.RuntimeServerHopPending ~= true then
					pcall(Respond.InvokeServer,Respond,chosen.Key,true)
				end
			end
			for requestKey in pairs(handledRequests) do
				if liveRequestKeys[requestKey]~=true then handledRequests[requestKey]=nil end
			end

			if #eligibleRequests == 0 then
				tryAutoSendTrade(u, requests)
			end

			local guid=isNormalTrade()
			if not guid then
				rawset(_G,"__DROIDHUB_NORMAL_TRADE_AUTOMATION_GUID",nil)
				lastGuid=nil; openingAppliedGuid=nil; autoReadyGuid=nil; table.clear(opponentItemCache)
				task.wait(0.30); continue
			end
			rawset(_G,"__DROIDHUB_NORMAL_TRADE_AUTOMATION_GUID",guid)
			autoServerHopState.RuntimeLastRegularTradeActivityAt = os.clock()
			if tostring(guid)~=tostring(lastGuid) then
				lastGuid=guid
				openingAppliedGuid=nil
				autoReadyGuid=nil
				table.clear(opponentItemCache)
				tradeReactionAt=os.clock()+tradeDelay(u,"AutoAcceptTradesReactionDelay",2.10)
			end

			local offerAutomationEnabled=regularOfferAutomationEnabled(u)
			local tradeMessageDelaySatisfied=true
			if tostring(u._LastTradeMessageGuid or "")==tostring(guid) then
				local sentAt=tonumber(u._LastTradeMessageSentAt) or 0
				tradeMessageDelaySatisfied=os.clock()-sentAt>=tradeDelay(u,"AutoAcceptTradesDelayAfterTradeMessage",1.80)
			end
			if offerAutomationEnabled then
				if tradeMessageDelaySatisfied and tostring(openingAppliedGuid)~=tostring(guid) then
					if not (u.RegularOpeningAutoshowBestBrainrots==true
						or u.RegularOpeningCustomBrainrots==true
						or u.RegularOpeningAutoshowAllTokens==true
						or u.RegularOpeningCustomTokens==true)
					then
						openingAppliedGuid=guid
					elseif applyOpeningOffer(u) then
						openingAppliedGuid=guid
					else
						-- Do not let a reactive offer race an opening offer that has not
						-- replicated yet; retry the verified opening state first.
						task.wait(0.10)
						continue
					end
				end
				if tradeMessageDelaySatisfied and os.clock()>=tradeReactionAt then applyOwnOffer(u) end
			else
				openingAppliedGuid=nil
			end

			local ready=try(Negotiation,{"player1","ready"})==true
			if u.AutoAcceptTradesAcceptOffers==true then
				local requirementsOK,configured=acceptRequirements(u)
				if configured and requirementsOK then
					local due=(tonumber(try(Negotiation,{"timers","lastUpdate"})) or -1)+3+tradeDelay(u,"AutoAcceptTradesAcceptDelay",1.35)
					if not ready and workspace:GetServerTimeNow()>=due then
						if u.PauseScript == true then task.wait(0.10); continue end
						local version=tonumber(try(Negotiation,{"timers","version"})) or 0
						pcall(Ready.FireServer,Ready,true,version)
						autoReadyGuid=tostring(guid)
					end
				elseif autoReadyGuid~=nil and tostring(autoReadyGuid)==tostring(guid) then
					if ready then
						local version=tonumber(try(Negotiation,{"timers","version"})) or 0
						pcall(Ready.FireServer,Ready,false,version)
					end
					autoReadyGuid=nil
				end
			elseif autoReadyGuid~=nil and tostring(autoReadyGuid)==tostring(guid) then
				if ready then
					local version=tonumber(try(Negotiation,{"timers","version"})) or 0
					pcall(Ready.FireServer,Ready,false,version)
				end
				autoReadyGuid=nil
			end
			task.wait(0.15)
		end
	end)
end
-- Completed regular-trade journal. A trade is logged only after both sides were
-- ready and an inventory/currency transfer is observed after the negotiation closes.
if MINIGAME_MODE then
	task.spawn(function()
		local RS = ReplicatedStorage
		local client = RS:WaitForChild("Client"):WaitForChild("Modules")
		local shared = RS:WaitForChild("Shared")
		local okRep, Replicator = pcall(require, client:WaitForChild("ReplicatorClient"))
		local okString, ItemToString = pcall(require, shared:WaitForChild("utils"):WaitForChild("ItemToString"))
		if not okRep or not Replicator then return end
		local activeGuid, captured
		local slotItemCache = {}
		local function playerData() return safeRepGet(Replicator, "PlayerData") end
		local function inventory()
			local data = playerData()
			local inv = data and safeTryIndex(data, {"Inventory"})
			return type(inv) == "table" and inv or {}
		end
		local function tokenBalance()
			local data = playerData()
			return math.max(0, math.floor(tonumber(data and safeTryIndex(data, {"TradeTokens"})) or 0))
		end
		local function slotSnapshot(negotiation, side)
			local result, ids = {}, {}
			local slots = safeTryIndex(negotiation, {side, "slots"})
			local ownInventory = side == "player1" and inventory() or nil
			for index = 1, 6 do
				local entry = type(slots) == "table" and (slots[tostring(index)] or slots[index]) or nil
				local id = type(entry) == "table" and entry.id or entry
				local item = type(entry) == "table" and entry.item or nil
				local cacheKey = tostring(side) .. ":" .. tostring(index)
				if type(item) ~= "table" and id ~= nil and type(ownInventory) == "table" then
					item = ownInventory[tostring(id)] or (tonumber(id) and ownInventory[tonumber(id)] or nil)
				end
				if type(item) == "table" then
					slotItemCache[cacheKey] = {Id = tostring(id or ""), Item = item}
				elseif id ~= nil then
					local cached = slotItemCache[cacheKey]
					if type(cached) == "table" and cached.Id == tostring(id) then item = cached.Item end
				else
					slotItemCache[cacheKey] = nil
				end
				if id ~= nil then ids[tostring(id)] = true end
				if type(item) == "table" then
					local display
					if okString and type(ItemToString) == "function" then
						pcall(function() display = ItemToString(item, {rich=false, displayLevel=true}) end)
					end
					result[#result + 1] = tostring(display or item.name or (item.sub and item.sub.name) or id or "Item")
				elseif id ~= nil then
					result[#result + 1] = "Item " .. tostring(id)
				end
			end
			local tokens = math.max(0, math.floor(tonumber(safeTryIndex(negotiation, {side, "currency"})) or 0))
			if tokens > 0 then result[#result + 1] = tostring(tokens) .. " Tokens" end
			return result, ids, tokens
		end
		local function offerText(parts) return #parts > 0 and table.concat(parts, ", ") or "Nothing" end
		local function logCompletedTrade(state)
			task.wait(0.55)
			if not screenGui.Parent or type(state) ~= "table" or state.SawBothReady ~= true then return end
			local inv = inventory()
			local transferred = false
			for id in pairs(state.MyIds or {}) do
				if inv[id] == nil and (not tonumber(id) or inv[tonumber(id)] == nil) then transferred = true break end
			end
			if not transferred then
				for id in pairs(state.TheirIds or {}) do
					if inv[id] ~= nil or (tonumber(id) and inv[tonumber(id)] ~= nil) then transferred = true break end
				end
			end
			if not transferred then
				local expected = math.max(0, math.floor((tonumber(state.BalanceBefore) or 0) - (tonumber(state.MyTokens) or 0) + (tonumber(state.TheirTokens) or 0)))
				transferred = tokenBalance() == expected and expected ~= (tonumber(state.BalanceBefore) or 0)
			end
			if not transferred then return end
			autoServerHopState.RuntimeLastRegularTradeActivityAt = os.clock()
			local resetStreak = autoServerHopState.ResetCanceledTradeStreak
			if type(resetStreak) == "function" and tonumber(state.UserId) then
				resetStreak(state.UserId)
			end
			local line = "TRADE | " .. tostring(state.Name or "Unknown")
				.. " | My Offer: " .. offerText(state.MyOffer or {})
				.. " | Their Offer: " .. offerText(state.TheirOffer or {})
