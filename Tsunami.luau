    end
    local mad = median(deviations)
    if not mad or mad <= 1e-9 then return center end
    local limit = math.max(0.0005, mad * 3.5)
    local filtered = {}
    for _, value in ipairs(values) do
        if math.abs(value - center) <= limit then
