                            if utilityAO["Fallback" .. tostring(occurrence.SourceRarity) .. "OfferAllTokens"] == true then
                                forceAllTokensAO = true
                            else
                                aggregateTokens += math.clamp(
                                    math.floor(tonumber(
                                        utilityAO["FallbackTokens" .. occurrence.SourceRarity]
                                    ) or 0),
                                    0,
                                    1000000
                                )
                            end
