			+ UI.CONTENT_COLUMN_GAP
	local activePanels = unsupportedPanelGroups[
			selectedMenuItem
			]
		or {
		}
	local columnBottom = {
		[1] = panelTopPadding
			+ UI.PANEL_SCROLL_EDGE_INSET,
		[2] = panelTopPadding
			+ UI.PANEL_SCROLL_EDGE_INSET
	}
	local maxPanelOrder = 0
	for _, data in ipairs(activePanels) do
		if data.Frame.Visible then
			maxPanelOrder = math.max(maxPanelOrder, tonumber(data.Order) or 0)
		end
	end
	local function placePanel(data, layoutColumn)
		data.LayoutWidth = cardWidth
		if type(data.RelayoutRows) == "function" then
			data.RelayoutRows(true)
		end
		local targetHeight = data.Expanded
			and (data.ExpandedHeight or UI.PANEL_EXPANDED_HEIGHT)
			or (data.HeaderHeight or UI.PANEL_COLLAPSED_HEIGHT)
		local x = layoutColumn == 1 and leftX or rightX
		local y = columnBottom[layoutColumn]
		data.Frame.Position = U2O(x, y)
		if instant then
			data.Frame.Size = U2O(cardWidth, targetHeight)
		else
			TweenService:Create(
				data.Frame,
				PANEL_TWEEN_INFO,
				{Size = U2O(cardWidth, targetHeight)}
			):Play()
		end
		columnBottom[layoutColumn] = y
			+ targetHeight
			+ UI.CONTENT_ROW_GAP
	end
	local speciallyPlaced = {}
	if singleColumn and selectedMenuItem == tabs.Autofarm then
		local function placeAutofarmPanelFirst(title)
			for _, data in ipairs(activePanels) do
				if data.Frame.Visible and data.Title == title then
					placePanel(data, 1)
					speciallyPlaced[data] = true
					return
				end
			end
		end
		placeAutofarmPanelFirst("Simple Auto Farm")
	end
	for order = 1, maxPanelOrder do
		for sourceColumn = 1, 2 do
			for _, data in ipairs(activePanels) do
				if data.Order == order
					and data.Column == sourceColumn
					and data.Frame.Visible
					and not speciallyPlaced[data] then
					placePanel(data, singleColumn and 1 or sourceColumn)
				end
			end
		end
	end
	local panelContentBottom = singleColumn
		and columnBottom[1]
		or math.max(columnBottom[1], columnBottom[2])
	if panelContentBottom
		> (
		panelTopPadding
			+ UI.PANEL_SCROLL_EDGE_INSET
		) then
		panelContentBottom -= UI.CONTENT_ROW_GAP
	end
	local contentEdgeSpacing = UI.CONTENT_SIDE_PADDING + UI.PANEL_SCROLL_EDGE_INSET
	local canvasHeight = math.max(
		contentHeight,
		panelContentBottom
			+ contentEdgeSpacing
		)
		+ math.max(
			0,
			tonumber(autoServerHopState.RuntimeDropdownBottomReserve) or 0
		)
	rightContent.CanvasSize = U2O(
		0,
		roundPixel(canvasHeight)
		)
end
