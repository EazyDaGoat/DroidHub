                            local objective = evaluatePlan(trialPlan)
                            if objective > bestObjective + 1e-8 then
                                bestObjective = objective
                                bestPlan = trialPlan
                                base = action
                                improved = true
                            end
                            if not enoughTime() then break end
                        end
