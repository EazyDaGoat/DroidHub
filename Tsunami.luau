		local function boothPriorityBlocksDeleteADI()
			local utility = autoServerHopState and autoServerHopState.Utility
			if not utility or utility.AutoBooth ~= true then return false end
			-- Only an active booth mutation/listing blocks deletion here. A stale
			-- evaluation must reach confirmBoothPriorityBeforeDeleteADI(), otherwise
			-- the confirmation path is unreachable and 95+ deletion can stall forever.
			return autoServerHopState.RuntimeBoothMutationBusy == true
				or autoServerHopState.RuntimeBoothListingsPending == true
		end
		local function confirmBoothPriorityBeforeDeleteADI()
			local utility = autoServerHopState and autoServerHopState.Utility
			if not utility or utility.AutoBooth ~= true then return true end
			if autoServerHopState.RuntimeBoothMutationBusy == true
				or autoServerHopState.RuntimeBoothListingsPending == true
			then
				return false
			end
			local started = os.clock()
			local evaluatedAt = tonumber(autoServerHopState.RuntimeBoothLastEvaluationAt) or 0
			-- Booth listings keep priority, but Auto Delete must not reset the booth
			-- worker's timestamp every attempt; doing that can perpetually defer 95+ deletion.
			if evaluatedAt > 0 and started - evaluatedAt <= 1.20 then
				return true
			end
			local deadline = started + 1.25
			repeat
				if deleteBlockedADI() then return false end
				if autoServerHopState.RuntimeBoothMutationBusy == true
					or autoServerHopState.RuntimeBoothListingsPending == true
				then
					return false
				end
				evaluatedAt = tonumber(autoServerHopState.RuntimeBoothLastEvaluationAt) or 0
				if evaluatedAt > 0 and evaluatedAt >= started - 0.10 then
					return true
				end
				task.wait(0.04)
			until os.clock() >= deadline
			return false
		end

		local function neverDeleteNameADI(item)
			if type(item) ~= "table" then return nil end
			local displayName
			pcall(function()
				displayName = ItemToStringADI(item, {
					rich = false,
					displayLevel = false,
					displayMutation = false,
				})
			end)
			return tostring(
				displayName
					or item.name
					or (item.sub and item.sub.name)
					or item.displayName
					or item.DisplayName
					or ""
			)
		end
		local function neverDeleteADI(item, id)
			local state = autoServerHopState and autoServerHopState.Utility
			if not state or type(item) ~= "table" then return false end
			-- A Roblox inventory lock is always authoritative protection. Simple Autofarm
			-- never unlocks/deletes a locked item just to advance its rarity floor.
			if item.locked == true then return true end
			local itemType = inventoryItemTypeADI(item)
			local effectiveRarity = effectiveBrainrotRarityADI(item)
			-- Eternal is a terminal progression reward; never discard it automatically.
			if effectiveRarity == "Eternal" then return true end
			if state.NeverDeleteNonBrainrots == true and itemType ~= "Brainrot" then
				return true
			end
			if state.NeverDeleteRaritiesEnabled == true
				and type(state.NeverDeleteRarities) == "table"
				and effectiveRarity ~= nil
				and state.NeverDeleteRarities[effectiveRarity] == true
			then
				return true
			end
			if state.NeverDeleteEnabled == true then
				local name = neverDeleteNameADI(item)
				local directName = tostring(item.name or (item.sub and item.sub.name) or "")
				local rules = type(state.NeverDeleteSpecificItems) == "table" and state.NeverDeleteSpecificItems or {}
				for _, rule in ipairs(rules) do
					if type(rule) == "table" and rule.Item ~= nil and tostring(rule.Item) ~= "" then
						if (autoServerHopState.SpecificItemNamesEquivalent(name, rule.Item)
							or autoServerHopState.SpecificItemNamesEquivalent(directName, rule.Item))
							and autoServerHopState.ItemMatchesSpecificRule(item, rule)
						then return true end
					end
				end
			end
			local mutation = item.mutation or item.Mutation
				or (item.sub and (item.sub.mutation or item.sub.Mutation))
			if type(mutation) == "string"
				and type(state.AvoidDeletingMutations) == "table"
				and state.AvoidDeletingMutations[mutation] == true
			then
				return true
			end
			local traits = item.traits or item.Traits
				or (item.sub and (item.sub.traits or item.sub.Traits))
			if type(state.AvoidDeletingTraits) == "table" then
				if type(traits) == "table" then
					for key, value in pairs(traits) do
						local trait = type(key) == "number" and value or key
						if value ~= nil and value ~= false and state.AvoidDeletingTraits[tostring(trait)] == true then
							return true
						end
					end
				elseif type(traits) == "string" then
					for trait in string.gmatch(traits, "[^,|;]+") do
						trait = string.gsub(trait, "^%s*(.-)%s*$", "%1")
						if state.AvoidDeletingTraits[trait] == true then return true end
					end
				end
			end
			if state.AvoidDeletingSignedBrainrots == true
				and inventoryItemTypeADI(item) == "Brainrot"
				and autoServerHopState.ItemSignature(item) == "Signed"
			then
				return true
			end
			if state.AvoidDeletingLockedItems == true and item.locked == true then
				return true
			end
			if id ~= nil and type(autoServerHopState.InventoryConsumeAllowed) == "function"
				and not autoServerHopState.InventoryConsumeAllowed(id, item, "Delete", nil, inventoryDataADI())
			then
				return true
			end
			local sizeName = autoServerHopState.ItemSizeName(item)
			if sizeName
				and type(state.AvoidDeletingSizes) == "table"
				and state.AvoidDeletingSizes[sizeName] == true
			then
				return true
			end
			local level = autoServerHopState.ItemLevel(item)
			if level ~= nil
				and type(state.AvoidDeletingLevels) == "table"
				and state.AvoidDeletingLevels[tostring(math.floor(level + 0.5))] == true
			then
				return true
			end
			return false
		end
		local function isCapacityNonBrainrotCandidateADI(item, id, listedIds)
			if id == nil
				or (listedIds or boothListedIdsADI())[tostring(id)] == true
				or type(item) ~= "table"
				or neverDeleteADI(item, id)
			then
				return false
			end
			return inventoryItemTypeADI(item) ~= "Brainrot"
		end
		local function nonBrainrotIdsADI()
			local ids = {}
			local listed = boothListedIdsADI()
			for id, item in pairs(inventoryDataADI() or {}) do
				if isCapacityNonBrainrotCandidateADI(item, id, listed) then
					ids[#ids + 1] = id
				end
			end
			return ids
		end
		local function modifierCountADI(item)
			if type(item) ~= "table" then return math.huge end
			local count = 0
			local sub = type(item.sub) == "table" and item.sub or nil
			local mutation = (sub and sub.mutation) or item.mutation
			if type(mutation) == "string" then
				local lower = string.lower(mutation)
				if lower ~= "" and lower ~= "none" then
					count += 1
				end
			elseif mutation ~= nil and mutation ~= false then
				count += 1
			end
			local traits = (sub and sub.traits) or item.traits
			if type(traits) == "table" then
				for key, value in pairs(traits) do
					if value ~= nil and value ~= false then
						if type(key) == "number" then
							if tostring(value) ~= "" then
								count += 1
							end
						elseif value == true
							or type(value) == "number"
							or type(value) == "string"
							or type(value) == "table"
						then
							count += 1
						end
					end
				end
			elseif type(traits) == "string" then
				local trimmed = string.gsub(traits, "^%s*(.-)%s*$", "%1")
				if trimmed ~= "" and string.lower(trimmed) ~= "none" then
					for _ in string.gmatch(trimmed, "[^,|;]+") do
						count += 1
					end
				end
			end
			return count
		end
		local function deletionBucketADI(item, id, listedIds)
			if id == nil
				or (listedIds or boothListedIdsADI())[tostring(id)] == true
				or type(item) ~= "table"
				or neverDeleteADI(item, id)
				or inventoryItemTypeADI(item) ~= "Brainrot"
			then
				return nil
			end
			local rarity = effectiveBrainrotRarityADI(item)
			if rarity == "Eternal" then return nil end
			if rarity == "Paradox"
				and not (
					autoServerHopState.Utility.SimpleAutofarmEnabled == true
					and autoServerHopState.RuntimeSimpleAutofarmTargetRarity == "Eternal"
				)
			then
				return nil
			end
			return type(rarity) == "string" and RARITY_ORDER_ADI[rarity] or nil
		end
		local function worstBrainrotIdADI()
			local inventory = inventoryDataADI()
			if not inventory then return nil end
			local listed = boothListedIdsADI()
			local worstBucket = math.huge
			for id, item in pairs(inventory) do
				local bucket = deletionBucketADI(item, id, listed)
				if bucket ~= nil and bucket < worstBucket then
					worstBucket = bucket
				end
			end
			if worstBucket == math.huge then return nil end
			local minimumModifiers = math.huge
			local exactWorst = {}
			for id, item in pairs(inventory) do
				if deletionBucketADI(item, id, listed) == worstBucket then
					local modifiers = modifierCountADI(item)
					if modifiers < minimumModifiers then
						minimumModifiers = modifiers
						table.clear(exactWorst)
					end
					if modifiers == minimumModifiers then exactWorst[#exactWorst + 1] = id end
				end
			end
			if #exactWorst == 0 then return nil end
			return exactWorst[math.random(1, #exactWorst)]
		end

		local function simpleProgressionReplacementIdADI()
			if autoServerHopState.Utility.SimpleAutofarmEnabled ~= true then return nil end
			local baseline = math.max(1, math.floor(tonumber(autoServerHopState.RuntimeSimpleAutofarmBaselineBrainrots) or 0))
			if baseline <= 0 then return nil end
			local target = autoServerHopState.RuntimeSimpleAutofarmTargetRarity
			local targetRank = RARITY_ORDER_ADI[target]
			if not targetRank then return nil end
			local inventory = inventoryDataADI()
			if not inventory then return nil end
			local listed = boothListedIdsADI()
			local brainrotCount = 0
			for id, item in pairs(inventory) do
				if listed[tostring(id)] ~= true and inventoryItemTypeADI(item) == "Brainrot" then
					brainrotCount += 1
				end
			end
			if brainrotCount <= baseline then return nil end
			local bestId, bestRank = nil, math.huge
			for id, item in pairs(inventory) do
				if listed[tostring(id)] ~= true and not neverDeleteADI(item, id) then
					local rarity = effectiveBrainrotRarityADI(item)
					local rank = RARITY_ORDER_ADI[rarity]
					if rank and rank < targetRank and rank < bestRank
						and deletionBucketADI(item, id, listed) ~= nil
					then
						bestId, bestRank = id, rank
					end
				end
			end
			return bestId
		end

		local function unlockInventoryEntryIfNeededADI(id)
			if autoServerHopState.Utility.PauseScript == true then return false end
			local inventory = inventoryDataADI()
			local item = inventory and (
				inventory[id]
				or inventory[tostring(id)]
				or (tonumber(id) and inventory[tonumber(id)] or nil)
			)
			if not item or item.locked ~= true then
				return true
			end
			if not LockInventoryItemADI then
				return false
			end
			if autoServerHopState.Utility.PauseScript == true then return false end
			local fired = pcall(function()
				if autoServerHopState.Utility.PauseScript == true then return end
				LockInventoryItemADI:FireServer(tostring(id), false)
			end)
			if not fired then return false end
			local started = os.clock()
			repeat
				task.wait(0.05)
				inventory = inventoryDataADI()
				item = inventory and (
					inventory[id]
						or inventory[tostring(id)]
						or (tonumber(id) and inventory[tonumber(id)] or nil)
				)
				if not item or item.locked ~= true then
					return true
				end
			until os.clock() - started >= 0.75
			return false
		end
		local function deleteNonBrainrotEntryCompletelyADI(id)
			local state = autoServerHopState and autoServerHopState.Utility
			if not state
				or state.AutoDeleteWorstInventory ~= true
				or id == nil
				or isBoothListedADI(id)
				or deleteBlockedADI()
			then
				return false
			end
			local inventory = inventoryDataADI()
			local item = inventory and (
				inventory[id]
					or inventory[tostring(id)]
					or (tonumber(id) and inventory[tonumber(id)] or nil)
			)
			if not item then return true end
			if not isCapacityNonBrainrotCandidateADI(item, id) then
				return false
			end
			local stableType = tostring(inventoryItemTypeADI(item) or "NonBrainrot")
			local stableName = tostring(item.name or (item.sub and item.sub.name) or "")
			local stableGuid = tostring(item.guid or item.id or "")
			for confirmation = 1, 3 do
				state = autoServerHopState and autoServerHopState.Utility
				if not state
					or state.AutoDeleteWorstInventory ~= true
					or deleteBlockedADI()
				then
					return false
				end
				inventory = inventoryDataADI()
				item = inventory and (
					inventory[id]
						or inventory[tostring(id)]
						or (tonumber(id) and inventory[tonumber(id)] or nil)
				)
				if not item then return true end
				if not isCapacityNonBrainrotCandidateADI(item, id) then
					return false
				end
				local liveType = tostring(inventoryItemTypeADI(item) or "NonBrainrot")
				local liveName = tostring(item.name or (item.sub and item.sub.name) or "")
				local liveGuid = tostring(item.guid or item.id or "")
				if liveType ~= stableType
					or liveName ~= stableName
					or liveGuid ~= stableGuid
				then
					return false
				end
				if confirmation < 3 then task.wait(0.05) end
			end
			if not unlockInventoryEntryIfNeededADI(id) then
				return false
			end
			inventory = inventoryDataADI()
			item = inventory and (
				inventory[id]
					or inventory[tostring(id)]
					or (tonumber(id) and inventory[tonumber(id)] or nil)
			)
			if not item
				or deleteBlockedADI()
				or not isCapacityNonBrainrotCandidateADI(item, id)
			then
				return false
			end
			local finalType = tostring(inventoryItemTypeADI(item) or "NonBrainrot")
			local finalName = tostring(item.name or (item.sub and item.sub.name) or "")
			local finalGuid = tostring(item.guid or item.id or "")
			if finalType ~= stableType
				or finalName ~= stableName
				or finalGuid ~= stableGuid
			then
				return false
			end
			if not DeleteInventoryItemADI then
				return false
			end
			if autoServerHopState.Utility.PauseScript == true then return false end
			local ok, success = pcall(function()
				if autoServerHopState.Utility.PauseScript == true then return false end
				return DeleteInventoryItemADI:InvokeServer(tostring(id), 1)
			end)
			if not ok or success ~= true then
				return false
			end
			local ackUntil = os.clock() + 1.00
			repeat
				task.wait(0.05)
				inventory = inventoryDataADI()
				if not inventory
					or (
						inventory[id] == nil
						and inventory[tostring(id)] == nil
						and (
							not tonumber(id)
							or inventory[tonumber(id)] == nil
						)
					)
				then
					return true
				end
			until os.clock() >= ackUntil
			return false
		end
		local function deleteBrainrotEntryCompletelyADI(id)
			local state = autoServerHopState and autoServerHopState.Utility
			if not state
				or state.AutoDeleteWorstInventory ~= true
				or id == nil
				or isBoothListedADI(id)
				or deleteBlockedADI()
			then
				return false
			end
			local function capacityClassification(item)
				if type(item) ~= "table"
					or inventoryItemTypeADI(item) ~= "Brainrot"
				then
					return nil
				end
				local rarity = effectiveBrainrotRarityADI(item)
				if type(rarity) ~= "string"
					or RARITY_ORDER_ADI[rarity] == nil
					or rarity == "Eternal"
					or (
					rarity == "Paradox"
					and not (
						autoServerHopState.Utility.SimpleAutofarmEnabled == true
						and autoServerHopState.RuntimeSimpleAutofarmTargetRarity == "Eternal"
					)
				)
				then
					return nil
				end
				local name = item.name or (item.sub and item.sub.name)
				return tostring(name or ""),
					rarity,
					brainrotIsMetaADI(item),
					tostring(item.guid or item.id or "")
			end
			local inventory = inventoryDataADI()
			local item = inventory and (
				inventory[id]
					or inventory[tostring(id)]
					or (tonumber(id) and inventory[tonumber(id)] or nil)
			)
			if not item then
				return false
			end
			local stableName, stableRarity, stableMeta, stableGuid =
				capacityClassification(item)
			if not stableName then
				return false
			end
			for confirmation = 1, 3 do
				state = autoServerHopState and autoServerHopState.Utility
				if not state
					or state.AutoDeleteWorstInventory ~= true
					or deleteBlockedADI()
				then
					return false
				end
				inventory = inventoryDataADI()
				item = inventory and (
					inventory[id]
						or inventory[tostring(id)]
						or (tonumber(id) and inventory[tonumber(id)] or nil)
				)
				if not item then
					return true
				end
				local name, rarity, isMeta, guid =
					capacityClassification(item)
				if name ~= stableName
					or rarity ~= stableRarity
					or isMeta ~= stableMeta
					or guid ~= stableGuid
				then
					return false
				end
				if confirmation < 3 then
					task.wait(0.05)
				end
			end
			if not unlockInventoryEntryIfNeededADI(id) then
				return false
			end
			inventory = inventoryDataADI()
			item = inventory and (
				inventory[id]
					or inventory[tostring(id)]
					or (tonumber(id) and inventory[tonumber(id)] or nil)
			)
			if not item or deleteBlockedADI() then
				return false
			end
			local finalName, finalRarity, finalMeta, finalGuid =
				capacityClassification(item)
			if finalName ~= stableName
				or finalRarity ~= stableRarity
				or finalMeta ~= stableMeta
				or finalGuid ~= stableGuid
			then
				return false
			end
			if not DeleteInventoryItemADI then
				return false
			end
			if autoServerHopState.Utility.PauseScript == true then return false end
			local ok, success = pcall(function()
				if autoServerHopState.Utility.PauseScript == true then return false end
				return DeleteInventoryItemADI:InvokeServer(tostring(id), 1)
			end)
			if not ok or success ~= true then
				return false
			end
			local ackUntil = os.clock() + 1.00
			repeat
				task.wait(0.05)
				inventory = inventoryDataADI()
				if not inventory
					or (
						inventory[id] == nil
						and inventory[tostring(id)] == nil
						and (
							not tonumber(id)
							or inventory[tonumber(id)] == nil
						)
					)
				then
					return true
				end
			until os.clock() >= ackUntil
			return false
		end
		while screenGui.Parent do
			task.wait(0.30)
			local state = autoServerHopState and autoServerHopState.Utility
			if state and state.PauseScript == true then
				task.wait(0.50)
				continue
			end
			if deleteBusyADI
				or not state
				or state.AutoDeleteWorstInventory ~= true
				or deleteBlockedADI()
				or boothPriorityBlocksDeleteADI()
			then
				continue
			end
			local threshold = math.clamp(
				math.floor(
					tonumber(state.DeleteInventoryThreshold) or 95
				),
				1,
				100
			)
			local progressionReplacementId = simpleProgressionReplacementIdADI()
			if progressionReplacementId == nil and effectiveInventoryCountADI() < threshold then
				continue
			end
			if progressionReplacementId == nil and not confirmBoothPriorityBeforeDeleteADI() then
				continue
			end
			local deleteNonFirst = state.DeleteNonBrainrotsFirst == true
			local deleteBrainrotFirst = state.DeleteWorstBrainrotsFirst == true
			if not deleteNonFirst and not deleteBrainrotFirst then
				if state.SimpleAutofarmEnabled == true then
					deleteNonFirst = true
				else
					continue
				end
			end
			local brainrotId, junkId
			if progressionReplacementId == nil then
				brainrotId = worstBrainrotIdADI()
				local junkIds = nonBrainrotIdsADI()
				junkId = #junkIds > 0
					and junkIds[math.random(1, #junkIds)]
					or nil
			end
			local selectedId
			local selectedKind
			if progressionReplacementId ~= nil then
				selectedId = progressionReplacementId
				selectedKind = "Brainrot"
			-- Either priority mode can delete both categories; the toggle only decides
			-- which eligible category is tried first before falling through to the other.
			elseif deleteNonFirst then
				if junkId ~= nil then
					selectedId = junkId
					selectedKind = "NonBrainrot"
				elseif brainrotId ~= nil then
					selectedId = brainrotId
					selectedKind = "Brainrot"
				end
			else
				if brainrotId ~= nil then
					selectedId = brainrotId
					selectedKind = "Brainrot"
				elseif junkId ~= nil then
					selectedId = junkId
					selectedKind = "NonBrainrot"
				end
			end
			if selectedId == nil then
				continue
			end
			local selectedInventory = inventoryDataADI()
			local selectedItem = selectedInventory and (
				selectedInventory[selectedId]
					or selectedInventory[tostring(selectedId)]
					or (tonumber(selectedId) and selectedInventory[tonumber(selectedId)] or nil)
			)
			local selectedDisplay = tostring(selectedId)
			local selectedRarity
			if type(selectedItem) == "table" then
				pcall(function()
					selectedDisplay = tostring(ItemToStringADI(selectedItem, {
						rich = false,
						displayLevel = false,
						displayMutation = false,
					}) or selectedDisplay)
				end)
				selectedRarity = getItemRarityADI(selectedItem)
			end
			deleteBusyADI = true
			local deleteOk, deleted
			if selectedKind == "NonBrainrot" then
				deleteOk, deleted = pcall(deleteNonBrainrotEntryCompletelyADI, selectedId)
			else
				deleteOk, deleted = pcall(deleteBrainrotEntryCompletelyADI, selectedId)
			end
			deleteBusyADI = false
			if deleteOk and deleted == true
				and autoServerHopState.Utility.PrintAutoDeletesToTerminal == true
			then
				local parts = {
					"AUTO DELETE",
					"Item: " .. selectedDisplay,
					"Type: " .. tostring(selectedKind),
				}
				if selectedRarity then parts[#parts + 1] = "Rarity: " .. tostring(selectedRarity) end
				print(table.concat(parts, " | "))
				print(string.rep("\\", 10))
			end
		end
	end)
end
-- Normal player-to-player trade automation. This intentionally runs in its own
-- task/scope so it does not add register pressure to the large top-level chunk.
if MINIGAME_MODE then
	task.spawn(function()
		local RS=ReplicatedStorage
		local Shared=RS:WaitForChild("Shared")
		local ClientModules=RS:WaitForChild("Client"):WaitForChild("Modules")
		local function safeRequire(module) local ok,v=pcall(require,module); return ok and v or nil end
		local Rep=safeRequire(ClientModules:WaitForChild("ReplicatorClient"))
