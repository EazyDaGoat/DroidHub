		local function setAdaptiveRowInteraction()
			if adaptiveLockApplyKey == nil then return end
			local locked = adaptiveLockActive()
			featureRow:SetAttribute("DroidHubAdaptiveLocked", locked)
			if definition and definition.HideAdaptiveLockedToggle == true then
				toggleTrack.Visible = not locked
			end
			if locked then
				local activeDropdown = autoServerHopState.RuntimeActivePanelDropdown
				local activeButton = type(activeDropdown) == "table" and activeDropdown.Button or nil
				if typeof(activeButton) == "Instance" and activeButton:IsDescendantOf(featureRow) then
					autoServerHopState.CloseActivePanelDropdown()
				end
			end
			local function shouldLock(object)
				if not locked then return false end
				if adaptiveLockScope == "Criteria" then
					return object ~= toggleTrack and not object:IsDescendantOf(toggleTrack)
				elseif adaptiveLockScope == "ToggleOnly" then
					return object == toggleTrack or object:IsDescendantOf(toggleTrack)
				end
				return true
			end
			for _, object in ipairs(featureRow:GetDescendants()) do
				local lockObject = shouldLock(object)
				if object:IsA("GuiButton") then
					pcall(function() object.Interactable = not lockObject end)
				elseif object:IsA("TextBox") then
					pcall(function() object.TextEditable = not lockObject end)
					if lockObject then pcall(object.ReleaseFocus, object) end
				end
			end
		end

		setAdaptiveRowInteraction()
		toggleTrack.MouseButton1Click:Connect(function()
			if adaptiveLockActive()
				and (adaptiveLockScope == "All" or adaptiveLockScope == "ToggleOnly")
			then
				return
			end
			if isInfoNote
				or isDropdownOnly
				or isServerHopSliderOnly
				or isUtilityText
				or isUtilitySlider
				or isUtilityDropdown
				or isUtilityMultiDropdown
			then
				return
			end
			if definition and definition.MomentaryAction then
				if autoServerHopState.Utility.PauseScript == true
					and definition.MomentaryAction ~= "ManualServerHop"
					and definition.MomentaryAction ~= "ManualKickMinigame"
				then
					return
				end
				if definition.MomentaryAction == "ManualServerHop" then
					local request = autoServerHopState.RequestManualHop
					if type(request) == "function" then request(false) end
				elseif definition.MomentaryAction == "ManualKickMinigame" then
					local request = autoServerHopState.RequestManualHop
					if type(request) == "function" then request(true) end
				end
				featureEnabled = false
				if stateEntry and definition.UtilityToggleKey then
					stateEntry[definition.UtilityToggleKey] = false
				end
				setToggleVisual(toggleTrack, toggleKnob, featureLabel, false)
				return
			end
			if isUtilityToggle and stateEntry then
				featureEnabled = stateEntry[definition.UtilityToggleKey] ~= true
			else
				featureEnabled = not featureEnabled
			end
			if isUtilityToggle and definition.UtilityToggleKey == "SimpleAutofarmEnabled" then
				local setter = rawget(_G, "__DROIDHUB_SET_SIMPLE_AUTOFARM")
				if type(setter) == "function" then pcall(setter, featureEnabled) end
				featureEnabled = stateEntry and stateEntry.SimpleAutofarmEnabled == true or false
				setToggleVisual(toggleTrack, toggleKnob, featureLabel, featureEnabled)
				refreshUtilityChildVisibility()
				relayoutRows()
				return
			end
			if isUtilityToggle then
				if stateEntry then
					if definition.UtilityToggleKey == "PauseScript" and featureEnabled then
						autoServerHopState.RuntimeServerHopPending = false
						autoServerHopState.RuntimeServerHopHardFreeze = false
			autoServerHopState.RuntimeServerHopFreezeCFrame = nil
						autoServerHopState.RuntimeScriptUserHopRequested = false
					end
					if utilityExclusiveGroup then
						local desiredSelected =
							utilityExclusiveRequired
								and true
								or stateEntry[definition.UtilityToggleKey] ~= true
						featureEnabled = desiredSelected
						for _, rowData in ipairs(featureRows) do
							if rowData.UtilityExclusiveGroup == utilityExclusiveGroup
								and rowData.UtilityToggleKey
							then
								local selected = desiredSelected
									and rowData.UtilityToggleKey
