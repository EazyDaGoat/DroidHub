			if type(synTable) == "table" and type(synTable.request) == "function" then return synTable.request end
			local httpTable = env.http or rawget(_G, "http")
			if type(httpTable) == "table" and type(httpTable.request) == "function" then return httpTable.request end
		end
		local function decodeServerPageHP(body)
			if type(body) ~= "string" or body == "" then return nil end
			local decoded
			local okDecode = pcall(function() decoded = HttpServiceHP:JSONDecode(body) end)
			return okDecode and type(decoded) == "table" and decoded or nil
		end
		local function fetchServerPageHP(requestFn, cursor)
			local url = "https://games.roblox.com/v1/games/" .. tostring(DROIDHUB_HOP_PLACE_ID)
				.. "/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true"
			if cursor and cursor ~= "" then url ..= "&cursor=" .. HttpServiceHP:UrlEncode(cursor) end
			if requestFn then
				local ok, response = pcall(requestFn, {
					Url = url,
					Method = "GET",
					Headers = { ["Accept"] = "application/json" },
				})
				if ok and response ~= nil then
					local body
					if type(response) == "string" then
						body = response
					elseif type(response) == "table" then
						body = response.Body or response.body
					end
					local decoded = decodeServerPageHP(body)
					if decoded then return decoded end
				end
			end
			local body
			local okHttpGet = pcall(function() body = game:HttpGet(url) end)
			if not okHttpGet then return nil end
			return decodeServerPageHP(body)
		end
		local function collectCandidatesHP(forcedManual)
			-- Server discovery is read-only and may run while a trade/game is active.
			-- Explicit manual departures may also discover a destination while the
			-- automation is paused.
			if autoServerHopState.Utility.PauseScript == true
				and forcedManual ~= true
			then
				return {}
			end
			local requestFn = requestFunctionHP()
			local candidates = {}
			local seen = {}
			local cursor
			refreshPersistentBlacklistHP()
			pruneServerBlacklistHP()
			-- The API is already sorted by player count descending. Stop as soon as
			-- ten eligible servers are known; later pages cannot outrank them.
			for _ = 1, 3 do
				if autoServerHopState.Utility.PauseScript == true
					and forcedManual ~= true
				then
					break
				end
				local decoded = fetchServerPageHP(requestFn, cursor)
				if not decoded then break end
				for _, server in ipairs(decoded.data or {}) do
					local id = server.id
					local playing = tonumber(server.playing)
					local maxPlayers = tonumber(server.maxPlayers)
					if type(id) == "string"
						and id ~= ""
						and id ~= game.JobId
						and not seen[id]
						and not serverBlacklistedHP(id)
						and playing
						and maxPlayers
						and maxPlayers > 0
						and playing < maxPlayers
					then
						seen[id] = true
						candidates[#candidates + 1] = {
							id = id,
							playing = playing,
							maxPlayers = maxPlayers,
							fullness = playing / maxPlayers,
							openSlots = maxPlayers - playing,
						}
						-- Public-server results are already descending by player count.
						-- Once ten eligible servers are collected, nothing later in this
						-- page or a later page can enter the top ten.
						if #candidates >= 10 then break end
					end
				end
				cursor = decoded.nextPageCursor
				if #candidates >= 10 or type(cursor) ~= "string" or cursor == "" then break end
			end
			table.sort(candidates, function(a, b)
				if a.playing ~= b.playing then return a.playing > b.playing end
				if a.fullness ~= b.fullness then return a.fullness > b.fullness end
				if a.openSlots ~= b.openSlots then return a.openSlots < b.openSlots end
				return a.id < b.id
			end)
			while #candidates > 10 do
				candidates[#candidates] = nil
			end
			return candidates
		end
		local function refreshServerCacheHP(forcedManual)
			if cacheRefreshingHP
				or not screenGui.Parent
				or (
					autoServerHopState.Utility.PauseScript == true
					and forcedManual ~= true
				)
			then
				return
			end
			cacheRefreshingHP = true
			local ok, candidates = pcall(collectCandidatesHP, forcedManual)
			if ok
				and (
					autoServerHopState.Utility.PauseScript ~= true
					or forcedManual == true
				)
				and type(candidates) == "table"
				and #candidates > 0
			then
				cachedCandidatesHP = candidates
				serverCacheAtHP = os.clock()
			end
			cacheRefreshingHP = false
		end
		local function chooseTopTenHP(candidates)
			if type(candidates) ~= "table" or #candidates == 0 then return nil end
			local eligible = {}
			refreshPersistentBlacklistHP()
			for _, candidate in ipairs(candidates) do
				if candidate.id ~= game.JobId
					and not serverBlacklistedHP(candidate.id)
					and tonumber(candidate.playing)
					and tonumber(candidate.maxPlayers)
					and candidate.playing < candidate.maxPlayers
				then
					eligible[#eligible + 1] = candidate
				end
			end
			if #eligible == 0 then return nil end
			table.sort(eligible, function(a, b)
				if a.playing ~= b.playing then return a.playing > b.playing end
				if a.fullness ~= b.fullness then return a.fullness > b.fullness end
				if a.openSlots ~= b.openSlots then return a.openSlots < b.openSlots end
				return a.id < b.id
			end)
			local topCount = math.min(10, #eligible)
			return eligible[serverRngHP:NextInteger(1, topCount)]
		end
		local function cachedChoiceHP()
			return chooseTopTenHP(cachedCandidatesHP)
		end
		local function freshPresenceChoiceHP()
			if serverCacheAtHP <= 0 then return nil end
			if os.clock() - serverCacheAtHP > PRESENCE_HOP_CACHE_MAX_AGE_HP then return nil end
			return cachedChoiceHP()
		end
		local function hopDifferentHP()
			local collisionDueHP = presenceDueHP()
			local manualDueHP = autoServerHopState.RuntimeManualServerHopRequested == true
			if not manualDueHP and os.clock() < wagerNotBeforeHP then return end
			if hopPreparationBlockedHP(activeMinigameHP(), manualDueHP) then return end
			local presenceWarmHP = true
			if not manualDueHP
				and not collisionDueHP
				and autoServerHopState.LeaveIfScriptUserInServer == true
			then
				local startedAt = tonumber(autoServerHopState.RuntimePresenceStartedAt) or os.clock()
				local connectedAt = tonumber(autoServerHopState.RuntimeGlobalPresenceConnectedAt)
				presenceWarmHP = (connectedAt ~= nil and os.clock() - connectedAt >= 0.20)
					or os.clock() - startedAt >= 0.75
			end
			if not presenceWarmHP or hoppingHP or not scheduledDueHP() then return end
			-- From this exact point onward the hop is committed. Do not let any
			-- minigame/trade/autosit controller regain movement while HTTP selection
			-- or TeleportService is still working.
