			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not bounds or not root then return false end
			local p = root.Position
			return p.X >= bounds.MinX
				and p.X <= bounds.MaxX
				and p.Z >= bounds.MinZ
				and p.Z <= bounds.MaxZ
		end
		local function rosterStableCS()
			local now = os.clock()
