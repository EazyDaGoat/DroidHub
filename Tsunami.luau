                    math.floor(tonumber(utilityAO.FallbackBestAvailableBrainrotAmount) or 6),
                    1,
                    6
                )
                if (slotIndex - 1) < bestGoal then
                    for _, itemId in ipairs(highestNonEternalOfferIdsAO(100) or {}) do
