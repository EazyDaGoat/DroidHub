				if not utilityExclusiveGroup then
					local registry = autoServerHopState.RuntimeUtilityToggleRows
					local mirroredRows = type(registry) == "table"
						and registry[definition.UtilityToggleKey] or nil
					if type(mirroredRows) == "table" then
						for _, rowData in ipairs(mirroredRows) do
							setToggleVisual(
								rowData.ToggleTrack,
								rowData.ToggleKnob,
								rowData.FeatureLabel,
								stateEntry[definition.UtilityToggleKey] == true
							)
						end
					end
					if autoServerHopState.RuntimeActivePanelDropdown then autoServerHopState.CloseActivePanelDropdown() end
					refreshUtilityChildVisibility()
				end
				relayoutRows()
				if definition.UtilityToggleKey == "UndoAllSettings" and featureEnabled then
					task.defer(function()
						local reset = rawget(_G, "__DROIDHUB_RESET_ALL_SETTINGS_STATE")
						if type(reset) == "function" then pcall(reset) end
						local refresh = rawget(_G, "__DROIDHUB_REFRESH_ALL_SETTINGS_UI")
						if type(refresh) == "function" then pcall(refresh) end
					end)
				end
			elseif isServerHop then
				if stateEntry then stateEntry[definition.ServerHopKey] = featureEnabled end
				if isServerHopMaster then
					if autoServerHopState.RuntimeActivePanelDropdown then autoServerHopState.CloseActivePanelDropdown() end
					for _, rowData in ipairs(featureRows) do
						if rowData.ServerHopChild then
							rowData.Row.Visible = featureEnabled
							if rowData.ServerHopSliderOnly and rowData.AmountContainer then
								rowData.AmountContainer.Visible = featureEnabled
								for _, control in ipairs(rowData.AmountControls or {}) do
									control.Frame.Visible = featureEnabled
								end
							end
						end
					end
					relayoutRows()
				end
			elseif isAutoCancelRarity then
				if stateEntry then
					stateEntry.Targets = type(stateEntry.Targets) == "table" and stateEntry.Targets or {}
					stateEntry.Targets[definition.AutoCancelRarityKey] = featureEnabled and true or nil
				end
				refreshUtilityChildVisibility()
			elseif isAutoCancel then
				if stateEntry then stateEntry.Enabled = featureEnabled end
			elseif isAutoOfferSourceManager or hasDropdown or isAutoAccept or isAutoSit then
				if stateEntry then stateEntry.Enabled = featureEnabled end
				refreshUtilityChildVisibility()
				if isAutoAccept then
					for _, rowData in ipairs(featureRows) do
						if rowData.RefreshFromState then rowData.RefreshFromState() end
					end
				end
			elseif definition and minigameAutoplayState then
				minigameAutoplayState[definition.Id] = featureEnabled
				if autoServerHopState.RuntimeActivePanelDropdown then autoServerHopState.CloseActivePanelDropdown() end
				refreshUtilityChildVisibility()
				relayoutRows()
			end
			if hasDropdown and not isDropdownOnly and amountContainer then
				amountContainer.Visible = featureEnabled
				for _, control in ipairs(amountControls) do
					control.Frame.Visible = featureEnabled
						and (
							(isOfferSubrow and control.Option == "Tokens")
							or (
								stateEntry
								and stateEntry.Targets
								and stateEntry.Targets[control.Option] == true
							)
						)
						or false
					if control.Frame.Visible and control.SetAmount then
						control.SetAmount(
							control.Option == "Tokens"
								and stateEntry.Tokens
								or stateEntry.Amounts[control.Option],
							true
						)
					end
				end
				relayoutRows()
			end
			if (isAutoAccept or isAutoCancelRarity) and amountControls[1] then
				amountControls[1].Frame.Visible = featureEnabled
				if amountContainer then amountContainer.Visible = featureEnabled end
				relayoutRows()
			end
			if isServerHop and definition.SliderKey and amountControls[1] then
				amountControls[1].Frame.Visible = featureEnabled
				if amountContainer then amountContainer.Visible = featureEnabled end
				relayoutRows()
			end
			if (isAutoSit or isOfferSubrow or isAutoCancel or isCustomReplyManager or isTradeChatOfferManager or isSpecificCriteriaManager or isAutoOfferSourceManager)
				and secondaryContainer
			then
				secondaryContainer.Visible = featureEnabled
					and not (hideAdaptiveLockedSecondary and adaptiveLockActive())
				if secondaryLabel then
					local secondaryColor = isAutoCancel
						and ((stateEntry and next(stateEntry.Targets) ~= nil) and UI.MENU_TEXT_SELECTED or UI.MUTED_TEXT_COLOR)
						or (featureEnabled and UI.MENU_TEXT_SELECTED or UI.MUTED_TEXT_COLOR)
					TweenService:Create(
						secondaryLabel,
						TI(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{TextColor3 = secondaryColor}
					):Play()
				end
				relayoutRows()
			end
			autoServerHopState.RefreshAllSettingsUiSoon()
			TweenService:Create(toggleTrack, TI(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = featureEnabled and UI.PINK or UI.FEATURE_OFF_COLOR}):Play()
			TweenService:Create(featureLabel, TI(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = featureEnabled and UI.MENU_TEXT_SELECTED or UI.MUTED_TEXT_COLOR}):Play()
			TweenService:Create(toggleKnob, TI(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = featureEnabled and U2(0, toggleWidth - toggleHeight + knobInset, 0, knobInset) or U2O(knobInset, knobInset)
			}):Play()
		end)
		local function refreshFeatureRowFromState()
			if isSimpleAutofarmWarning then
				featureRow.Visible = os.clock() < (tonumber(autoServerHopState.RuntimeSimpleAutofarmWarningUntil) or 0)
				featureLabel.TextColor3 = RGB(255, 74, 74)
				return
			elseif isInfoNote then
				featureRow.Visible = (
					type(visibilityUtilityParents) ~= "table"
					or utilityParentsEnabled(autoServerHopState.Utility, visibilityUtilityParents)
				) and (
					type(visibilityAnyUtilityParents) ~= "table"
					or anyUtilityParentEnabled(autoServerHopState.Utility, visibilityAnyUtilityParents)
				) and (
					visibilitySitKey == nil
					or (type(autoSitState) == "table" and type(autoSitState[visibilitySitKey]) == "table" and autoSitState[visibilitySitKey].Enabled == true)
				)
				featureLabel.Text = tostring(definition.InfoNoteText or "")
				featureLabel.TextColor3 = isDangerInfoNote and RGB(255, 74, 74) or UI.MUTED_TEXT_COLOR
				return
			elseif isActionButton then
				featureRow.Visible = (
					type(visibilityUtilityParents) ~= "table"
					or utilityParentsEnabled(autoServerHopState.Utility, visibilityUtilityParents)
				) and (
					type(visibilityAnyUtilityParents) ~= "table"
					or anyUtilityParentEnabled(autoServerHopState.Utility, visibilityAnyUtilityParents)
				)
				return
			end
			if isDropdownOnly then
				featureEnabled = true
			elseif isUtilityToggle then
				featureEnabled = stateEntry and stateEntry[definition.UtilityToggleKey] == true or false
			elseif isUtilityText or isUtilitySlider or isUtilityDropdown or isUtilityMultiDropdown or isSpecificCriteriaManager then
				featureEnabled = stateEntry and utilityParentsEnabled(stateEntry, utilityParents) or false
			elseif isAutoCancel then
				featureEnabled = isAutoCancelFilterOnly or (stateEntry and stateEntry.Enabled == true or false)
			elseif isServerHopSliderOnly then
				featureEnabled = definition.ServerHopSliderAlwaysVisible == true
					or (autoServerHopState and autoServerHopState.Enabled == true or false)
			elseif isServerHop then
				featureEnabled = stateEntry and stateEntry[definition.ServerHopKey] == true or false
			elseif isAutoOfferSourceManager then
				featureEnabled = stateEntry and stateEntry.Enabled == true or false
			elseif isAutoCancelRarity
				and definition
				and definition.AutoCancelDirectSlider == true
			then
				featureEnabled = true
			elseif isAutoCancelRarity then
				featureEnabled = stateEntry and type(stateEntry.Targets) == "table"
					and stateEntry.Targets[definition.AutoCancelRarityKey] == true or false
			elseif hasDropdown or isAutoAccept or isAutoSit then
				featureEnabled = stateEntry and stateEntry.Enabled == true or false
			else
				featureEnabled = definition and minigameAutoplayState and minigameAutoplayState[definition.Id] == true or false
			end
			local utilityVisible = not isUtilityChild
				or utilityParentsEnabled(autoServerHopState.Utility, utilityParents)
			local visibilityVisible = type(visibilityUtilityParents) ~= "table"
				or utilityParentsEnabled(autoServerHopState.Utility, visibilityUtilityParents)
			local anyVisibilityVisible = type(visibilityAnyUtilityParents) ~= "table"
				or anyUtilityParentEnabled(autoServerHopState.Utility, visibilityAnyUtilityParents)
			featureRow.Visible = not (hideWhenUtilityTrueKey ~= nil and autoServerHopState.Utility[hideWhenUtilityTrueKey] == true)
				and (
				not isServerHopChild
				or definition.ServerHopSliderAlwaysVisible == true
				or autoServerHopState.Enabled == true
			)
				and utilityVisible
				and visibilityVisible
				and anyVisibilityVisible
				and (
					(definition and definition.MinigameParentId) == nil
					or (
						type(minigameAutoplayState) == "table"
						and minigameAutoplayState[definition.MinigameParentId] == true
					)
				)
				and (
					visibilityAutoOfferSource == nil
					or (type(autoOfferState) == "table" and type(autoOfferState[visibilityAutoOfferSource]) == "table" and autoOfferState[visibilityAutoOfferSource].Enabled == true)
				)
				and (
					visibilityAcceptKey == nil
					or (type(acceptStateTable) == "table" and type(acceptStateTable[visibilityAcceptKey]) == "table" and acceptStateTable[visibilityAcceptKey].Enabled == true)
				)
				and (
					visibilityAutoCancelTarget == nil
					or (type(autoCancelState) == "table" and type(autoCancelState.Targets) == "table" and autoCancelState.Targets[visibilityAutoCancelTarget] == true)
				)
				and (
					not (definition and definition.VisibilityAutoCancelInventoryCriteria == true)
					or autoServerHopState.Utility.AutoCancelCheckOpponentsBrainrots == true
					or autoServerHopState.Utility.AutoCancelBasedOnSpecificItems == true
				)
				and (
					visibilitySitKey == nil
					or (type(autoSitState) == "table" and type(autoSitState[visibilitySitKey]) == "table" and autoSitState[visibilitySitKey].Enabled == true)
				)
				and (
					visibilityAutoSitTarget == nil
					or (type(autoSitState) == "table" and type(autoSitState.OneOfTwo) == "table"
						and type(autoSitState.OneOfTwo.Targets) == "table"
						and autoSitState.OneOfTwo.Targets[visibilityAutoSitTarget] == true)
				)
				and (
					(definition and definition.BoothSlotIndex) == nil
					or definition.BoothSlotIndex
						<= (tonumber(autoServerHopState.RuntimeBoothMaxSlots) or 3)
				)
			if definition and definition.HideWhenAdaptiveAndDisabled == true and adaptiveLockActive() and not featureEnabled then
				featureRow.Visible = false
			end
			if definition and definition.HideAdaptiveLockedToggle == true then
				toggleTrack.Visible = not adaptiveLockActive()
			end
			setToggleVisual(toggleTrack, toggleKnob, featureLabel, featureEnabled)
			if secondaryContainer then
				secondaryContainer.Visible = (isDropdownOnly or featureEnabled)
					and featureRow.Visible
					and not (hideAdaptiveLockedSecondary and adaptiveLockActive())
			end
			if amountContainer then amountContainer.Visible = featureEnabled and featureRow.Visible end
			if utilityDropdownRefresh then utilityDropdownRefresh() end
			if utilityTextBox and stateEntry then
				utilityTextBox.Text = tostring(stateEntry[definition.UtilityTextKey] or "")
				utilityTextBox.TextColor3 = utilityTextBox.Text ~= "" and UI.MENU_TEXT_SELECTED or UI.MUTED_TEXT_COLOR
			end
			if standardDropdownButton and stateEntry then
				updateDropdownText(standardDropdownButton, stateEntry, (definition and definition.SitKey ~= nil) and "Any" or definition.Placeholder, definition.Options)
			end
			if isUtilitySlider or isServerHopSliderOnly or (isServerHop and definition.SliderKey) then
				for _, control in ipairs(amountControls) do
					-- Slider frames are created using the parent's state at construction time.
					-- A parent that starts disabled therefore creates a hidden slider frame.
					-- Re-sync the inner frame as well as AmountContainer whenever settings
					-- refresh, otherwise enabling the parent later reveals only the slider
					-- row label (for example Best Available Brainrots / No-Value Timeout).
					control.Frame.Visible = featureEnabled and featureRow.Visible
					if control.SetAmount then
						local key = control.Option
						control.SetAmount(stateEntry and stateEntry[key], true)
					end
				end
			elseif isAutoAccept then
				for _, control in ipairs(amountControls) do
					control.Frame.Visible = featureEnabled
					if control.SetAmount then control.SetAmount(stateEntry and stateEntry.Amount, true) end
				end
			elseif isAutoCancelRarity then
				for _, control in ipairs(amountControls) do
					control.Frame.Visible = featureEnabled
					if control.SetAmount then
						control.SetAmount(
							control.Option == "Tokens"
								and (
									definition.AutoCancelDirectSlider == true
										and not (
											type(stateEntry.Targets) == "table"
											and stateEntry.Targets.Tokens == true
										)
										and 0
										or stateEntry.Tokens
								)
								or (stateEntry.Amounts and stateEntry.Amounts[control.Option]),
							true
						)
					end
				end
			elseif hasDropdown and stateEntry then
				for _, control in ipairs(amountControls) do
					local visible = featureEnabled and (
						(isOfferSubrow and control.Option == "Tokens")
						or (stateEntry.Targets and stateEntry.Targets[control.Option] == true)
					) or false
					control.Frame.Visible = visible
					if visible and control.SetAmount then
						control.SetAmount(control.Option == "Tokens" and stateEntry.Tokens or stateEntry.Amounts[control.Option], true)
					end
				end
			end
			setAdaptiveRowInteraction()
		end
		local function syncPrimaryRowLayout(baseHeight)
