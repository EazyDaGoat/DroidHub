					if r and g and b then swatch.BackgroundColor3 = RGB(r,g,b) return true end
				end
				return false
			end
			syncSwatch()
			box.FocusLost:Connect(function()
				box.Text = string.upper(tostring(box.Text or ""))
				if string.sub(box.Text,1,1) ~= "#" then box.Text = "#" .. box.Text end
