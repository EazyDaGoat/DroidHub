			return
		end
		if autoServerHopState.RuntimeSidebarScrollDragging == true then return end

		local canvasHeight = menuHolder.AbsoluteCanvasSize.Y
		local windowHeight = menuHolder.AbsoluteWindowSize.Y
		local maxY = math.max(0, canvasHeight - windowHeight)
		local trackHeight = track.AbsoluteSize.Y
		local thumbHeight = thumb.AbsoluteSize.Y
		local maxTravel = math.max(0, trackHeight - thumbHeight)
		if maxY <= 0 or maxTravel <= 0 then return end

		local pointerY = input.Position.Y - track.AbsolutePosition.Y
		local centeredY = math.clamp(
			pointerY - (thumbHeight * 0.5),
			0,
			maxTravel
		)
		menuHolder.CanvasPosition = V2(
			0,
			math.clamp((centeredY / maxTravel) * maxY, 0, maxY)
		)

		autoServerHopState.RuntimeSidebarScrollDragging = true
		autoServerHopState.RuntimeSidebarScrollDragInput = input
		autoServerHopState.RuntimeSidebarScrollDragStartY = input.Position.Y
		autoServerHopState.RuntimeSidebarScrollDragStartCanvasY =
			menuHolder.CanvasPosition.Y
	end)

	UserInputService.InputChanged:Connect(function(input)
		if autoServerHopState.RuntimeSidebarScrollDragging ~= true then return end
		local activeInput = autoServerHopState.RuntimeSidebarScrollDragInput
		if not activeInput then return end

		if activeInput.UserInputType == Enum.UserInputType.Touch then
			if input ~= activeInput then return end
		elseif input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local canvasHeight = menuHolder.AbsoluteCanvasSize.Y
		local windowHeight = menuHolder.AbsoluteWindowSize.Y
		local maxY = math.max(0, canvasHeight - windowHeight)
		local trackHeight = track.AbsoluteSize.Y
		local thumbHeight = thumb.AbsoluteSize.Y
		local maxTravel = math.max(0, trackHeight - thumbHeight)
		if maxY <= 0 or maxTravel <= 0 then return end

		local startY = tonumber(autoServerHopState.RuntimeSidebarScrollDragStartY)
			or input.Position.Y
		local startCanvasY =
			tonumber(autoServerHopState.RuntimeSidebarScrollDragStartCanvasY) or 0
		local deltaY = input.Position.Y - startY
		local canvasDelta = (deltaY / maxTravel) * maxY

		menuHolder.CanvasPosition = V2(
			0,
			math.clamp(startCanvasY + canvasDelta, 0, maxY)
		)
	end)

	UserInputService.InputEnded:Connect(function(input)
		if autoServerHopState.RuntimeSidebarScrollDragging ~= true then return end
		local activeInput = autoServerHopState.RuntimeSidebarScrollDragInput

		if activeInput
			and activeInput.UserInputType == Enum.UserInputType.Touch
			and input ~= activeInput
		then
			return
		end
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch
		then
			return
		end

		autoServerHopState.RuntimeSidebarScrollDragging = false
		autoServerHopState.RuntimeSidebarScrollDragInput = nil
	end)
end

autoServerHopState.SyncSidebarScrollBar = function()
	local track = autoServerHopState.RuntimeSidebarScrollBarTrack
	local thumb = autoServerHopState.RuntimeSidebarScrollBarThumb
	if not track or not track.Parent or not thumb or not thumb.Parent then return end

	local canvasHeight = menuHolder.AbsoluteCanvasSize.Y
	local windowHeight = menuHolder.AbsoluteWindowSize.Y
	local maxY = math.max(0, canvasHeight - windowHeight)
	if maxY <= 1 or canvasHeight <= 0 or windowHeight <= 0 then
		track.Visible = false
		return
	end

	local trackHeight = track.AbsoluteSize.Y
	if trackHeight <= 0 then
		track.Visible = false
		return
	end

	local thumbHeight = math.max(
		px(22),
		roundPixel(trackHeight * math.clamp(windowHeight / canvasHeight, 0, 1))
	)
	thumbHeight = math.min(trackHeight, thumbHeight)
	local maxTravel = math.max(0, trackHeight - thumbHeight)
	local ratio = math.clamp(menuHolder.CanvasPosition.Y / maxY, 0, 1)

	thumb.Position = U2O(0, roundPixel(maxTravel * ratio))
	thumb.Size = U2(1, 0, 0, thumbHeight)
	track.Visible = true
end

