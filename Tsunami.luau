                and setDesiredItemsAO(guid, desiredIds)
            if tokenOk and itemOk and tryIndexAO(negotiationAO, {"guid"}) == guid then
                lastAppliedSignature = desiredSignature
                pendingSignature = nil
                pendingContext = nil
                reactionDueAt = 0
            else
                reactionDueAt = os.clock() + 0.10
            end
            task.wait(0.10)
        end
    end)
