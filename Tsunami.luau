							if delta.Magnitude > 0.05 then
								humanoid:Move(delta.Unit, false)
							end
						end
					)
				end)
				movementBound = ok
			end
			local function cleanup(stopMovement)
				if movementBound then
					pcall(function() RunServiceAS:UnbindFromRenderStep(movementBindName) end)
					movementBound = false
