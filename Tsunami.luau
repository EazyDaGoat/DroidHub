						scheduleBoothMessageAB(
							spec.ListedMessage,
							spec.MessageDelay,
							spec.MessageGuardKey
						)
					end
					return true
				end
			until os.clock() >= deadline
			return false
		end
		local function updateBoothNameAB(state)
