	row.Parent = menuHolder
	local button = New("TextButton")
	button.Name = name .. "Button"
	button.AnchorPoint = V2(0.5, 0.5)
	button.Position = U2(0.5, 0, 0.5, 0)
	button.Size = U2O(FIXED_TAB_HIGHLIGHT_WIDTH, UI.MENU_ITEM_HEIGHT)
	button.BackgroundColor3 = UI.SEARCH_BACKGROUND
	button.BackgroundTransparency = UI.MENU_NORMAL_TRANSPARENCY
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.ClipsDescendants = true
	button.ZIndex = 45001
	button.Parent = row
	ensureCorner(
		button,
		UI.MENU_CORNER_RADIUS
	)
	local activeLine = New("Frame")
	activeLine.Name = "ActiveLine"
	activeLine.AnchorPoint = V2(0, 0.5)
	activeLine.Position = U2(0, FIXED_ACTIVE_LINE_X, 0.5, 0)
	activeLine.Size = U2O(UI.MENU_ACTIVE_LINE_WIDTH, UI.MENU_ACTIVE_LINE_HEIGHT)
	activeLine.BackgroundColor3 = UI.PINK
	activeLine.BackgroundTransparency = 1
	activeLine.BorderSizePixel = 0
	activeLine.ZIndex = 45003
	activeLine.Parent = row
	ensureCorner(
		activeLine,
		math.max(
			1,
			math.floor(
				UI.MENU_ACTIVE_LINE_HEIGHT * 0.5
			)
		)
	)
	local iconAsset = getEmbeddedIconAsset(
			name
		)
	local icon
	if iconAsset then
		icon = New("ImageLabel")
		icon.Name = name .. "Icon"
		icon.AnchorPoint = V2(0, 0.5)
		icon.Position = U2(0, UI.MENU_ICON_X, 0.5, 0)
		icon.Size = U2O(UI.MENU_ICON_SIZE, UI.MENU_ICON_SIZE)
		icon.BackgroundTransparency = 1
		icon.BorderSizePixel = 0
		icon.Image = iconAsset
		icon.ImageColor3 = UI.PINK
		icon.ImageTransparency = 0.58
		icon.ScaleType = Enum.ScaleType.Fit
		icon.ZIndex = 45003
		icon.Parent = button
	else
		icon = New("TextLabel")
		icon.Name = name .. "IconFallback"
		icon.AnchorPoint = V2(0, 0.5)
		icon.Position = U2(0, UI.MENU_ICON_X, 0.5, 0)
		icon.Size = U2O(UI.MENU_ICON_SIZE, UI.MENU_ICON_SIZE)
		icon.BackgroundTransparency = 1
		icon.BorderSizePixel = 0
		icon.Text = fallbackGlyph
			or ""
		icon.TextColor3 = UI.PINK
		icon.TextTransparency = 0.58
		setResponsiveTextSize(icon, 14)
		icon.FontFace = UI.MENU_FONT_FACE
		icon.TextXAlignment = Enum.TextXAlignment.Center
		icon.TextYAlignment = Enum.TextYAlignment.Center
		icon.ZIndex = 45003
		icon.Parent = button
	end
	local label = New("TextLabel")
	label.Name = name .. "Label"
	label.AnchorPoint = V2(0, 0.5)
	label.Position = U2(0, UI.MENU_TEXT_X, 0.5, 0)
	label.Size = U2(
			1,
			-(UI.MENU_TEXT_X + 10),
			1,
			0
		)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = formatPanelTitle(TRACKED_TAB_NAME[name] or name, "sidebar")
	label.TextColor3 = UI.MENU_TEXT_IDLE
	label.FontFace = UI.MENU_FONT_SEMIBOLD_FACE
	setResponsiveTextSize(label, UI.MENU_TEXT_SIZE)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 45002
	label.Parent = button
	label:GetPropertyChangedSignal("TextBounds"):Connect(function()
		local refreshSidebarWidth = autoServerHopState.RefreshSidebarMinimumWidth
		if type(refreshSidebarWidth) == "function" then
			task.defer(refreshSidebarWidth)
		end
	end)
	local item = {
		Name = name,
		Row = row,
		Button = button,
		Label = label,
		Icon = icon,
		IconIsImage = iconAsset ~= nil,
		ActiveLine = activeLine,
		Hovered = false,
	}
	table.insert(
		menuItems,
		item
	)
	button.MouseEnter:Connect(function()
		item.Hovered = true
		updateMenuItemVisual(
			item,
			false
		)
	end)
	button.MouseLeave:Connect(function()
		item.Hovered = false
		updateMenuItemVisual(
			item,
			false
		)
	end)
	button.MouseButton1Up:Connect(function()
		selectMenuItem(item)
	end)
	return item
end
