local function update()
    local isActive = popcornActive()
    if isActive and not controller.wasActive then
        controller.wasActive = true
        resetRound()
    elseif not isActive and controller.wasActive then
        controller.wasActive = false
        resetRound()
        return
    end
    if isActive then
        armCurrentKernel()
        reportAndCalibrate()
    end
