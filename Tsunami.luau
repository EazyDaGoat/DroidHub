                                        forceAllTokensAO = true
                                    else
                                        local fallbackTokens = math.clamp(
                                            math.floor(tonumber(utilityAO["FallbackTokens" .. occurrence.SourceRarity]) or 0),
                                            0,
                                            1000000
                                        )
